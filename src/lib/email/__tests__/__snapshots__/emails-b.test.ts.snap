exports[`e-mails B no tema manifestacao > vazio-dia2: assunto e texto (snapshot) 1`] = `
{
  "assunto": "Um gasto. Só um.",
  "texto": "Lança só o último gasto que você lembra. Oi, Ana! Um gasto. Só um. Seu SPI Finance ainda está vazio, e tudo bem. Ninguém precisa organizar o mês inteiro hoje. Lança só o último gasto que você lembra: o café, o mercado, o Uber. Falando ou digitando, leva dez segundos. É a partir dele que o app começa a te mostrar quanto ainda está livre no mês e o que pede a sua atenção. Lançar agora Respondendo este e-mail, você fala com a gente. SPI Finance, sua vida financeira em um só lugar.",
}
`;

exports[`e-mails B no tema manifestacao > vazio-dia5: assunto e texto (snapshot) 1`] = `
{
  "assunto": "Posso te ajudar a começar?",
  "texto": "Responde este e-mail me contando. Oi, Ana. Posso te ajudar a começar? O seu SPI Finance continua em branco, e eu queria entender por quê. Às vezes é o extrato que não entrou, às vezes é a correria, às vezes a pessoa só não sabe por onde começar. Se for qualquer uma dessas, responde este e-mail me contando. A gente te ajuda a colocar o seu primeiro mês lá dentro. Abrir o SPI Finance Dani Respondendo este e-mail, você fala com a gente. SPI Finance, sua vida financeira em um só lugar.",
}
`;

exports[`e-mails B no tema padrao > acesso-liberado: assunto e texto (snapshot) 1`] = `
{
  "assunto": "Seu acesso ao SPI Finance está liberado",
  "texto": "Falta só criar sua conta para começar. Oi! Seu acesso está liberado Seu acesso ao SPI Finance foi liberado. Falta só criar sua conta para começar a organizar suas finanças: Criar minha conta Importante: cadastre-se usando exatamente este e-mail ( ana@exemplo.com ), é ele que está autorizado. Se você não reconhece este e-mail, pode ignorá-lo com segurança. SPI Finance, sua vida financeira em um só lugar.",
}
`;

exports[`e-mails B no tema padrao > boasvindas: assunto e texto (snapshot) 1`] = `
{
  "assunto": "Seu primeiro minuto no SPI Finance",
  "texto": "Uma coisa só: o seu primeiro gasto. Oi, Ana! Sua conta está pronta Antes de qualquer gráfico, o SPI Finance precisa de uma coisa só: o seu primeiro gasto. O jeito mais rápido é falar. Toca no + no meio da barra de baixo e diz, por exemplo: Toque no + e diga: “mercado, duzentos e quarenta reais” Pronto, ele entra no mês com a categoria certa. Se preferir fazer o mês inteiro de uma vez, exporta o extrato no app do seu banco e solta lá dentro. Lançar meu primeiro gasto Ficou com dúvida? Tem um guia curtinho de como usar dentro do app: no menu, em Como usar o app . Respondendo este e-mail, você fala com a gente. SPI Finance, sua vida financeira em um só lugar.",
}
`;

