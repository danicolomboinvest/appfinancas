// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  CLIENT
}

/// De onde veio a liberação de acesso de um e-mail: MANUAL (a Dani liberou no painel)
/// ou HUBLA (liberado automaticamente pelo webhook quando a pessoa comprou/assinou).
enum AccessSource {
  MANUAL
  HUBLA
}

enum EntryCategory {
  INCOME
  EXPENSE
  INVESTMENT_CONTRIBUTION
}

/// Categoria-mãe do lançamento (segunda camada de categorização, além de EntryCategory).
/// Só se aplica a lançamentos EXPENSE — usada para orçamento mensal por categoria.
enum ParentCategory {
  MORADIA
  ALIMENTACAO
  TRANSPORTE
  SAUDE
  LAZER
  EDUCACAO
  OUTROS
  IMPOSTOS
}

enum GoalStatus {
  NOT_STARTED
  ON_TRACK
  BEHIND
  ACHIEVED
}

/// Ícone temático escolhido pelo usuário para o card da meta.
enum GoalIcon {
  VIAGEM
  CASA
  CARRO
  APOSENTADORIA
  GENERICO
}

enum AssetClass {
  RENDA_FIXA
  ACAO
  FII
  TESOURO_DIRETO
  FUNDO
  CRIPTO
  /// Ativo negociado fora do Brasil (ações/ETFs em dólar, ex.: VOO, AAPL) ou fundo/gestora
  /// que investe no exterior — mapeia pro bucket "Exterior" da Estratégia da Carteira.
  INTERNACIONAL
  OUTRO
}

/// Indexador de um título de renda fixa (só faz sentido para RENDA_FIXA/TESOURO_DIRETO).
/// Define em qual classe da Estratégia o título entra: pós-fixado (CDI/Selic), IPCA+ ou prefixado.
enum FixedIncomeIndex {
  POS_FIXADO
  IPCA
  PREFIXADO
}

/// Objetivo ao qual o ativo está alocado — espelha as categorias da planilha original
/// (Reserva, Liberdade, Meta) para a consolidação "posição atual por objetivo".
enum AssetObjective {
  RESERVA_EMERGENCIA
  LIBERDADE_FINANCEIRA
  META
  OUTRO
}

enum SimulationType {
  FINANCIAR_VS_ALUGAR
  AMORTIZAR_VS_INVESTIR
  CONSORCIO_VS_FINANCIAMENTO
  MARCACAO_MERCADO
  CARRO
}

enum SheetType {
  STOCK
  FII
  STOCK_INTL
  ETF
}

enum FiiType {
  TIJOLO
  PAPEL
  HIBRIDO
  FUNDO_DE_FUNDOS
}

enum RateBasis {
  ANNUAL_252
  ANNUAL_365
  MONTHLY
}

/// Classes usadas na tela "Estratégia da Carteira" — mais granulares que AssetClass
/// (que continua sendo usada no cadastro de ativos individuais). A posição atual por
/// classe de estratégia é derivada de Asset.assetClass por uma função de mapeamento
/// padrão (ver lib/portfolio/strategy.ts), já que são taxonomias diferentes.
enum StrategyAssetClass {
  RENDA_FIXA_POS_FIXADA
  RENDA_FIXA_IPCA
  PREFIXADO
  ACOES_BRASIL
  FIIS
  EXTERIOR
  OUTROS
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  /// Celular (WhatsApp) — pedido no cadastro e/ou puxado da compra no Hubla.
  phone                String?
  name         String?
  avatarUrl    String?
  role         Role     @default(CLIENT)
  currency     String   @default("BRL")
  theme        String   @default("light")
  notifyBudgetAlerts Boolean @default(true)
  notifyLateGoals    Boolean @default(true)
  /// Resumo do mês por e-mail (o único e-mail recorrente do app). Ligado por padrão; quem não
  /// quiser desliga em Configurações › Preferências.
  notifyMonthlyRecap Boolean @default(true)
  /// Último mês cujo resumo JÁ foi enviado por e-mail, formato "YYYY-MM". Trava de idempotência:
  /// o cron pode rodar de novo (retry da Vercel, execução manual) sem reenviar o mesmo resumo.
  /// Vale para os DOIS e-mails do dia 1º (resumo de quem usou, convite de quem não usou) — o
  /// mês é tratado uma vez só, não importa qual dos dois saiu.
  recapEmailSentMonth String?
  /// Quantos convites "vamos começar?" já foram enviados. Quem não usa o app não pode receber
  /// esse lembrete todo mês pra sempre — depois de algumas tentativas sem resposta, o app para
  /// de insistir. Zera sozinho quando a pessoa passa a usar (aí ela recebe o resumo, não o convite).
  recapNudgeCount Int @default(0)
  /// Proteção contra força bruta: erros de senha consecutivos e trava temporária.
  failedLoginCount Int       @default(0)
  lockedUntil      DateTime?
  /// Última vez que o usuário abriu o app (atualizado no layout, no máx. 1x a cada ~15min).
  /// Base das métricas de engajamento (ativos em 24h/7d/30d) no relatório de admin.
  lastSeenAt   DateTime?
  /// Mês do Resumo Mensal já visto/fechado, formato "YYYY-MM". Enquanto for o mesmo mês do
  /// resumo atual, o card na Visão Mensal não aparece de novo (fecha uma vez por mês).
  recapDismissedMonth String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  monthlyEntries       MonthlyEntry[]
  budgets              Budget[]
  monthlyPlans         MonthlyPlan[]
  customCategories     CustomCategory[]
  portfolioStrategy    PortfolioStrategy[]
  patrimonySnapshots   PatrimonySnapshot[]
  assets               Asset[]
  goals                Goal[]
  emergencyFund        EmergencyFund?
  planningParams       PlanningParams?
  simulations          Simulation[]
  analysisSheets       AnalysisSheet[]
  referenceRates       ReferenceRate[]
  yearlyConsolidations YearlyConsolidationCache[]
  accumulationCache    AccumulationProjectionCache[]
  transactionRules     TransactionCategoryRule[]
  passwordResetTokens  PasswordResetToken[]
  importBatches        ImportBatch[]
  importDiagnostics ImportDiagnostic[]
  contributionAllocations ContributionAllocation[]
  usageEvents          UsageEvent[]

  asAdvisorLinks AdvisorClientLink[] @relation("advisor")
  asClientLinks  AdvisorClientLink[] @relation("client")
  pushSubscriptions PushSubscription[]
  notificationLogs  NotificationLog[]
  bankConnections   BankConnection[]
}

/// Token de recuperação de senha. Guardamos só o HASH do token (nunca o valor cru) — o link
/// enviado por e-mail carrega o token, e aqui comparamos pelo hash. Vale 1 hora e uma vez só.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

/// Regra aprendida de classificação de extrato (item 3 da Rodada 2): quando o usuário resolve
/// uma transação na fila de revisão, guardamos merchant → categoria para classificar sozinho
/// as próximas transações parecidas. `pattern` é a chave normalizada (ver normalizeMerchant).
model TransactionCategoryRule {
  id             String         @id @default(cuid())
  userId         String
  user           User           @relation(fields: [userId], references: [id])
  pattern        String
  parentCategory ParentCategory
  subcategory    String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@unique([userId, pattern])
  @@index([userId])
}

model AdvisorClientLink {
  id        String   @id @default(cuid())
  advisorId String
  clientId  String
  status    String // INVITED | ACTIVE | REVOKED
  advisor   User     @relation("advisor", fields: [advisorId], references: [id])
  client    User     @relation("client", fields: [clientId], references: [id])
  createdAt DateTime @default(now())

  @@unique([advisorId, clientId])
}

/// Tabela de premissas/taxas de referência editáveis (CDI, IPCA, Selic...).
/// userId nulo = taxa padrão global (seed do sistema).
model ReferenceRate {
  id            String    @id @default(cuid())
  userId        String?
  user          User?     @relation(fields: [userId], references: [id])
  name          String
  rateValue     Decimal   @db.Decimal(12, 6)
  basis         RateBasis
  effectiveDate DateTime
  createdAt     DateTime  @default(now())

  @@index([userId])
}

/// Categoria-mãe personalizada, criada pelo próprio usuário quando as 7 categorias fixas
/// (ParentCategory) não bastam. Vive fora do enum de propósito — o usuário pode apagar uma
/// categoria personalizada a qualquer momento, o que não faria sentido pra um valor de enum
/// (exigiria migração toda vez). Um MonthlyEntry/Budget de despesa pertence a exatamente uma
/// categoria: ou uma ParentCategory fixa, ou uma CustomCategory — nunca as duas (invariante
/// de aplicação, no mesmo espírito pragmático da subcategoria "Outro", que também não é enum).
model CustomCategory {
  id            String         @id @default(cuid())
  userId        String
  user          User           @relation(fields: [userId], references: [id])
  name          String
  icon          String
  createdAt     DateTime       @default(now())
  monthlyEntries MonthlyEntry[]
  budgets       Budget[]

  @@unique([userId, name])
}

/// Lançamento mensal — substitui as 12 abas Jan..Dez da planilha original.
/// Rastreio de uso PRÓPRIO (sem script de terceiro): cada navegação dentro do app vira um
/// evento — qual tela, quem, quando e se estava no app instalado (tela de início) ou no
/// navegador. Alimenta a seção "páginas mais visitadas" do /admin/relatorio. Admins não são
/// gravados (poluiriam a estatística).
model UsageEvent {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Tipo do evento; hoje só "pageview", o campo existe pra eventos futuros (ex.: "voz_usada").
  name       String
  /// Rota normalizada ("/mensal/[ano]/[mes]"), nunca a URL crua com ids.
  path       String
  /// true = app aberto pela tela de início (instalado), false = pelo navegador.
  standalone Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([userId, createdAt])
  @@index([path, createdAt])
}

/// Lote de importação: um upload de extrato/fatura. Dá o histórico do que foi subido em massa
/// e permite desfazer o lote inteiro (arquivo errado ou duplicado) de uma vez.
/// Erro de servidor que estourou em produção, guardado por 30 dias.
///
/// O log da Vercel cobre ~45 minutos e não há log drain: qualquer erro mais antigo que isso
/// some. Sem isso, "verificar todo dia os erros do app" não teria o que verificar. Guarda a
/// rota, a mensagem e a pilha cortada — nunca corpo de requisição, cookie ou dado de cliente.
model AppError {
  id         String   @id @default(cuid())
  /// Rota do arquivo ("/mensal/[year]/[month]"), não a URL com dados na query.
  routePath  String?
  /// render | route | action | proxy
  routeType  String?
  method     String?
  message    String
  digest     String?
  stack      String?
  /// Quantas vezes esta mesma assinatura (rota + mensagem) estourou.
  vezes      Int      @default(1)
  primeiroEm DateTime @default(now())
  ultimoEm   DateTime @default(now())

  @@unique([routePath, message])
  @@index([ultimoEm])
}

/// Diagnóstico de CADA tentativa de importação, inclusive as que falharam.
///
/// Sem isso, arquivo que o app não consegue ler não deixa rastro nenhum: nenhum lote é criado
/// e o log da Vercel some em poucos dias. Foi assim que sete pessoas pediram reembolso sem a
/// gente saber qual banco quebrou. Aqui fica o suficiente pra reproduzir: nome do arquivo,
/// o que o app entendeu, quantas linhas viu, quantas leu e o erro — nunca o conteúdo.
model ImportDiagnostic {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  /// "extrato" | "fatura" | "carteira"
  target      String
  /// "parse" (leitura) | "confirm" (gravação)
  stage       String
  ok          Boolean
  fileName    String?
  /// text | xlsx | pdf
  encoding    String?
  /// O que o perfil do documento concluiu: statement, invoice, position, irpf, unknown
  kind        String?
  institution String?
  /// Linhas com cara de dinheiro no arquivo × lançamentos/ativos que o app conseguiu ler.
  moneyLines  Int      @default(0)
  parsed      Int      @default(0)
  created     Int      @default(0)
  skipped     Int      @default(0)
  /// Mensagem que a pessoa viu na tela, quando deu errado.
  message     String?
  /// Primeira linha do arquivo (cabeçalho), cortada — é o que identifica o formato do banco.
  header      String?
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([ok, createdAt])
}

model ImportBatch {
  id        String         @id @default(cuid())
  userId    String
  user      User           @relation(fields: [userId], references: [id])
  /// "extrato" | "fatura"
  docType   String
  fileName  String?
  createdAt DateTime       @default(now())
  entries   MonthlyEntry[]

  @@index([userId, createdAt])
}

model MonthlyEntry {
  id               String          @id @default(cuid())
  userId           String
  user             User            @relation(fields: [userId], references: [id])
  year             Int
  month            Int
  category         EntryCategory
  parentCategory   ParentCategory?
  customCategoryId String?
  customCategory   CustomCategory? @relation(fields: [customCategoryId], references: [id])
  subcategory      String?
  description      String?
  amount           Decimal         @db.Decimal(18, 2)
  /// Lançamento feito em outra moeda (salário em euro pra quem mora fora): o valor digitado, a
  /// moeda dele e a cotação usada. `amount` continua sempre na moeda do usuário — todo o resto do
  /// app soma `amount` e não precisa saber que houve conversão.
  /// Id da transação no banco (Open Finance): "pluggy:<id>". É o que garante que uma
  /// transação nunca entra duas vezes, por definição, sem depender de descrição ou data.
  externalId       String?
  originalAmount   Decimal?        @db.Decimal(18, 2)
  originalCurrency String?         @db.VarChar(3)
  exchangeRate     Decimal?        @db.Decimal(14, 6)
  /// Data em que a despesa/renda de fato aconteceu (opcional — lançamentos antigos não têm).
  /// year/month continuam sendo a verdade para a consolidação mensal; entryDate refina o dia.
  entryDate        DateTime?       @db.Date
  goalId           String?
  goal             Goal?           @relation(fields: [goalId], references: [id])
  /// Pedaços deste aporte que já foram para ativos da carteira.
  allocations      ContributionAllocation[]
  /// Lote de importação que criou este lançamento (nulo = lançado à mão). SetNull: apagar o
  /// registro do lote nunca apaga lançamentos por efeito colateral — a exclusão em massa é
  /// sempre explícita na action, dentro de uma transação.
  importBatchId    String?
  importBatch      ImportBatch?    @relation(fields: [importBatchId], references: [id], onDelete: SetNull)
  createdAt        DateTime        @default(now())

  @@index([userId, year, month])
  @@index([userId, parentCategory])
  @@index([userId, customCategoryId])
  @@index([importBatchId])
  @@unique([userId, externalId])
}

/// Orçamento mensal planejado por categoria-mãe (para a barra "gasto realizado vs. planejado").
model Budget {
  id               String          @id @default(cuid())
  userId           String
  user             User            @relation(fields: [userId], references: [id])
  year             Int
  month            Int
  parentCategory   ParentCategory?
  customCategoryId String?
  customCategory   CustomCategory? @relation(fields: [customCategoryId], references: [id])
  plannedAmount    Decimal         @db.Decimal(18, 2)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@unique([userId, year, month, parentCategory, customCategoryId])
}

/// Planejamento do que ENTRA e do que vai ser guardado, por mês.
///
/// O Budget cobre só o que sai (gasto planejado por categoria). Faltava o outro lado: quanto a
/// pessoa espera ganhar e quanto pretende aportar. Sem isso o app comparava o gasto com o
/// planejado, mas não tinha como dizer "você ganhou menos do que esperava" nem "você aportou
/// metade do que tinha planejado" — que é onde mora metade da conversa sobre organizar dinheiro.
///
/// Uma linha por mês (igual ao Budget), mesmo quando o valor é o mesmo o ano todo: assim dá pra
/// ajustar um mês específico (décimo terceiro, férias) sem mexer nos outros.
model MonthlyPlan {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id])
  year              Int
  month             Int
  /// Renda esperada no mês.
  plannedIncome     Decimal  @db.Decimal(18, 2)
  /// Aporte pretendido no mês.
  plannedInvestment Decimal  @db.Decimal(18, 2)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([userId, year, month])
}

/// Cache opcional de consolidação anual (substitui Database -> Pivôs -> Consolidado do Ano).
/// Só deve ser preenchido/usado se aggregation queries diretas apresentarem latência real.
model YearlyConsolidationCache {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id])
  year            Int
  totalIncome     Decimal  @db.Decimal(18, 2)
  totalExpense    Decimal  @db.Decimal(18, 2)
  totalInvestment Decimal  @db.Decimal(18, 2)
  balance         Decimal  @db.Decimal(18, 2)
  updatedAt       DateTime @updatedAt

  @@unique([userId, year])
}

/// Metas múltiplas (uma linha por meta na planilha original).
model Goal {
  id                  String         @id @default(cuid())
  userId              String
  user                User           @relation(fields: [userId], references: [id])
  name                String
  targetAmount        Decimal        @db.Decimal(18, 2)
  targetDate          DateTime?
  currentAmount       Decimal        @default(0) @db.Decimal(18, 2)
  monthlyContribution Decimal?       @db.Decimal(18, 2)
  annualRate          Decimal?       @db.Decimal(12, 6)
  status              GoalStatus     @default(NOT_STARTED)
  icon                GoalIcon       @default(GENERICO)
  /// Mês (YYYY-MM) já perguntado "fez o aporte sugerido?" pra esta meta — mesmo padrão do
  /// User.recapDismissedMonth. Enquanto for o mesmo mês da janela atual, o check-in não
  /// aparece de novo (já foi respondido, seja "fiz", "fiz parcial" ou "não fiz").
  checkinDismissedMonth String?
  entries             MonthlyEntry[]
  assets              Asset[]
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
}

/// Para onde foi o dinheiro de um aporte: liga o lançamento do fluxo aos ativos da carteira.
///
/// Sem isso os três módulos não conversavam. A pessoa lançava "aportei R$ 2.500" no mês, ia na
/// carteira e não via nada; atualizava a carteira e o mês continuava igual; e a meta somava o
/// aporte E o ativo, contando o mesmo dinheiro duas vezes. Um aporte pode ser dividido em
/// vários ativos, então é uma linha por pedaço.
model ContributionAllocation {
  id        String       @id @default(cuid())
  userId    String
  user      User         @relation(fields: [userId], references: [id])
  entryId   String
  entry     MonthlyEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  assetId   String
  asset     Asset        @relation(fields: [assetId], references: [id], onDelete: Cascade)
  amount    Decimal      @db.Decimal(18, 2)
  createdAt DateTime     @default(now())

  @@index([userId, createdAt])
  @@index([entryId])
  @@index([assetId])
}

/// Reserva de emergência./// Reserva de emergência.
model EmergencyFund {
  id                  String   @id @default(cuid())
  userId              String   @unique
  user                User     @relation(fields: [userId], references: [id])
  targetMonths        Int
  monthlyExpenseBase  Decimal  @db.Decimal(18, 2)
  targetAmount        Decimal  @db.Decimal(18, 2)
  currentAmount       Decimal  @default(0) @db.Decimal(18, 2)
  monthlyContribution Decimal  @db.Decimal(18, 2)
  annualRate          Decimal  @db.Decimal(12, 6)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

/// Núcleo "Planejamento Financeiro" (acúmulo + usufruto).
model PlanningParams {
  id                              String   @id @default(cuid())
  userId                          String   @unique
  user                            User     @relation(fields: [userId], references: [id])
  currentAge                      Int
  retirementAge                   Int
  lifeExpectancyAge               Int?
  currentPatrimony                Decimal  @db.Decimal(18, 2)
  monthlyContributionAccumulation Decimal  @db.Decimal(18, 2)
  accumulationAnnualRate          Decimal  @db.Decimal(12, 6)
  inflationAnnualRate             Decimal  @db.Decimal(12, 6)
  usufructAnnualRate              Decimal  @db.Decimal(12, 6)
  desiredPassiveIncome            Decimal  @db.Decimal(18, 2)
  otherPassiveIncome              Decimal  @default(0) @db.Decimal(18, 2)
  createdAt                       DateTime @default(now())
  updatedAt                       DateTime @updatedAt
}

/// Cache opcional da projeção ano a ano (equivalente "Base Dash acum").
model AccumulationProjectionCache {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id])
  year              Int
  age               Int
  contributions     Decimal  @db.Decimal(18, 2)
  interestEarned    Decimal  @db.Decimal(18, 2)
  endingBalanceNom  Decimal  @db.Decimal(18, 2)
  endingBalanceReal Decimal  @db.Decimal(18, 2)
  updatedAt         DateTime @updatedAt

  @@unique([userId, year])
}

/// Minha Carteira.
model Asset {
  id                     String         @id @default(cuid())
  userId                 String
  user                   User           @relation(fields: [userId], references: [id])
  name                   String
  ticker                 String?
  assetClass             AssetClass
  objective              AssetObjective @default(OUTRO)
  goalId                 String?
  goal                   Goal?          @relation(fields: [goalId], references: [id])
  /// Aportes do fluxo que entraram neste ativo.
  allocations            ContributionAllocation[]
  quantity               Decimal?          @db.Decimal(18, 6)
  currentUnitPrice       Decimal?          @db.Decimal(18, 6)
  /// Indexador do título de renda fixa (CDI/Selic, IPCA+ ou prefixado). Refina o mapeamento
  /// pra Estratégia da Carteira; nulo para ações/FIIs/fundos ou RF sem indexador conhecido.
  fixedIncomeIndex       FixedIncomeIndex?
  /// Quanto foi investido (compra/aportes). A atualização de cotações NUNCA mexe aqui —
  /// é a referência fixa pro lucro/prejuízo (currentValue - investedValue).
  investedValue          Decimal?       @db.Decimal(18, 2)
  currentValue           Decimal        @db.Decimal(18, 2)
  idealAllocationPercent Decimal?       @db.Decimal(6, 3)
  acquisitionDate        DateTime?
  notes                  String?
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt
}

/// Provento (dividendo/JSCP/rendimento) de um TICKER — não de um Asset/usuário: um MXRF11 só
/// precisa ser raspado uma vez, mesmo com 50 pessoas tendo ele na carteira (mesmo espírito do
/// cache de cotação em Asset.currentUnitPrice). "Próximos dividendos" na Carteira faz o join
/// com Asset.ticker/quantity na hora de exibir, não guarda nada por usuário aqui.
model DividendEvent {
  id            String   @id @default(cuid())
  /// Normalizado maiúsculo ("MXRF11"), pra casar com Asset.ticker.
  ticker        String
  /// Texto original do investidor10 ("Dividendos", "JSCP", "Rend. Trib."...) — sem enum fechado
  /// porque o site já variou esse rótulo antes e um valor novo não pode quebrar o scraper.
  kind          String
  /// "Data com": quem tem o ativo até este dia tem direito ao provento.
  exDate        DateTime @db.Date
  paymentDate   DateTime @db.Date
  valuePerShare Decimal  @db.Decimal(18, 8)
  fetchedAt     DateTime @default(now())

  // Mesma linha raspada de novo (refresh diário) não duplica.
  @@unique([ticker, kind, exDate, paymentDate, valuePerShare])
  @@index([ticker])
  @@index([paymentDate])
}

/// Percentuais-alvo por classe de estratégia definidos pelo próprio usuário (soma = 100%),
/// independente da alocação-ideal por ativo individual em Asset.idealAllocationPercent.
model PortfolioStrategy {
  id            String             @id @default(cuid())
  userId        String
  user          User               @relation(fields: [userId], references: [id])
  assetClass    StrategyAssetClass
  targetPercent Decimal            @db.Decimal(6, 3)
  updatedAt     DateTime           @updatedAt

  @@unique([userId, assetClass])
}

/// Snapshot diário do patrimônio total (soma de Asset.currentValue), gravado de forma
/// oportunista na primeira leitura do dia (ver lib/portfolio/snapshot.ts). É a única peça de
/// histórico real que o app guarda sobre patrimônio — sem ela não há como responder "quanto
/// cresceu" ou "é um novo recorde", já que Asset só guarda o valor atual.
model PatrimonySnapshot {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  date       DateTime @db.Date
  totalValue Decimal  @db.Decimal(18, 2)
  createdAt  DateTime @default(now())

  @@unique([userId, date])
  @@index([userId, date])
}

/// Histórico opcional de simulações (financiar vs alugar, consórcio, marcação a mercado, carro).
model Simulation {
  id         String         @id @default(cuid())
  userId     String
  user       User           @relation(fields: [userId], references: [id])
  type       SimulationType
  name       String?
  inputJson  Json
  outputJson Json
  createdAt  DateTime       @default(now())
}

/// Catálogo compartilhado de critérios das fichas de análise (Ações / FIIs).
/// Editável pela educadora (ADMIN) sem necessidade de deploy.
model AnalysisCriterionDefinition {
  id        String             @id @default(cuid())
  sheetType SheetType
  key       String
  label     String
  helpText  String? // tooltip "onde encontrar os dados"
  category  String // agrupamento qualitativo/quantitativo (ou TIJOLO/PAPEL/COMUM para FIIs)
  weight    Decimal?           @db.Decimal(6, 3)
  order     Int
  active    Boolean            @default(true)
  responses AnalysisResponse[]

  @@unique([sheetType, key])
}

/// Ficha de análise de Ações ou FIIs preenchida por um usuário.
model AnalysisSheet {
  id           String             @id @default(cuid())
  userId       String
  user         User               @relation(fields: [userId], references: [id])
  sheetType    SheetType
  ticker       String
  companyName  String?
  fiiType      FiiType?
  analysisDate DateTime           @default(now())
  totalScore   Decimal?           @db.Decimal(8, 2)
  conclusion   String?
  /// Laudo automático (leitura dos indicadores com selo por régua), guardado como snapshot
  /// pra ficha abrir na hora e pra "Reanalisar" dizer o que mudou desde a última leitura.
  laudo        Json?
  laudoReadAt  DateTime?
  /// Nota automática que nasce dos selos (favorável 10 / na média 6 / atenção 2).
  autoScore    Decimal?           @db.Decimal(4, 2)
  responses    AnalysisResponse[]
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
}

model AnalysisResponse {
  id          String                      @id @default(cuid())
  sheetId     String
  sheet       AnalysisSheet               @relation(fields: [sheetId], references: [id], onDelete: Cascade)
  criterionId String
  criterion   AnalysisCriterionDefinition @relation(fields: [criterionId], references: [id])
  value       String?
  score       Decimal?                    @db.Decimal(6, 2)
  note        String?

  @@unique([sheetId, criterionId])
}

/// Lista de e-mails autorizados a criar conta / entrar no app. O acesso é fechado:
/// só quem está aqui e com active=true consegue se cadastrar e logar (admins são exceção).
/// Existe independente de User porque a checagem acontece no cadastro, antes da conta existir.
/// O e-mail é sempre guardado normalizado (minúsculo, sem espaços) para casar com o login.
model AllowedEmail {
  id        String       @id @default(cuid())
  email     String       @unique
  source    AccessSource @default(MANUAL)
  active    Boolean      @default(true)
  /// Anotação livre: turma, nome do produto no Hubla, motivo da liberação manual etc.
  note      String?
  /// Celular que veio da compra no Hubla — copiado pro User quando a conta é criada.
  phone     String?
  /// Data-limite do acesso (a assinatura é anual). Nulo = acesso sem prazo. Vencido não
  /// desativa sozinho (não apaga `active`) — só bloqueia login/cadastro e aparece como
  /// "Expirado" no painel, pra Dani decidir se renova ou desativa de vez.
  expiresAt DateTime?
  /// Última fatura do Hubla já processada. O Hubla manda o mesmo evento mais de uma vez
  /// (member_added + payment_succeeded, além de reenvios); sem essa trava, cada reenvio
  /// esticaria o acesso em mais um ano de graça.
  lastHublaInvoiceId String?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
}

/// Produtos do Hubla que dão acesso ao app. O webhook só libera uma compra se o produto
/// comprado estiver aqui e ativo — assim só os cursos certos liberam, e não qualquer produto.
/// `source` = MANUAL (a Dani adicionou pelo nome) ou HUBLA (o webhook viu numa compra e
/// cadastrou como inativo pra ela decidir). Casamento por hublaProductId (quando conhecido)
/// ou pelo nome normalizado (minúsculo, sem espaços nas pontas).
model AllowedProduct {
  id             String       @id @default(cuid())
  /// Id do produto no Hubla (event.product.id). Nulo quando a Dani cadastrou só pelo nome,
  /// antes de qualquer compra; o webhook preenche assim que vê a primeira venda daquele nome.
  hublaProductId String?      @unique
  name           String
  source         AccessSource @default(MANUAL)
  active         Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

/// Inscrição de notificação do navegador (Web Push): um aparelho instalado = uma linha.
/// Sem app na loja, é o que faz "chegar uma mensagem" no celular.
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Aviso já enviado (push ou e-mail), pra nunca repetir o mesmo aviso do mesmo mês.
model NotificationLog {
  id     String   @id @default(cuid())
  userId String
  key    String
  sentAt DateTime @default(now())
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
}

/// Conexão Open Finance (via Pluggy / Meu Pluggy). Um item do Pluggy = um banco conectado.
model BankConnection {
  id            String    @id @default(cuid())
  userId        String
  itemId        String    @unique
  connectorId   Int?
  connectorName String
  status        String    @default("UPDATED")
  lastSyncAt    DateTime?
  lastSyncCount Int       @default(0)
  lastError     String?
  createdAt     DateTime  @default(now())
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
