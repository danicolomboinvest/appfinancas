/// Minha Carteira.
model Asset {
  id                     String                   @id @default(cuid())
  userId                 String
  user                   User                     @relation(fields: [userId], references: [id])
  /// Perfil financeiro dono deste registro. Nulo só no histórico anterior aos perfis.
  profileId              String?
  profile                FinancialProfile?        @relation(fields: [profileId], references: [id], onDelete: Cascade)
  name                   String
  ticker                 String?
  assetClass             AssetClass
  objective              AssetObjective           @default(OUTRO)
  goalId                 String?
  goal                   Goal?                    @relation(fields: [goalId], references: [id])
  /// Aportes do fluxo que entraram neste ativo.
  allocations            ContributionAllocation[]
  quantity               Decimal?                 @db.Decimal(18, 6)
  currentUnitPrice       Decimal?                 @db.Decimal(18, 6)
  /// Indexador do título de renda fixa (CDI/Selic, IPCA+ ou prefixado). Refina o mapeamento
  /// pra Estratégia da Carteira; nulo para ações/FIIs/fundos ou RF sem indexador conhecido.
  fixedIncomeIndex       FixedIncomeIndex?
  /// Quanto foi investido (compra/aportes). A atualização de cotações NUNCA mexe aqui —
  /// é a referência fixa pro lucro/prejuízo (currentValue - investedValue).
  investedValue          Decimal?                 @db.Decimal(18, 2)
  currentValue           Decimal                  @db.Decimal(18, 2)
  /// Moeda em que o ativo está: "BRL" é a conta Brasil; "USD" é a conta no exterior (Avenue,
  /// Nomad…). investedValue/currentValue/currentUnitPrice continuam SEMPRE na moeda do app, para
  /// o total, as metas, a reserva e a estratégia somarem sem conversão em cada tela. O valor na
  /// moeda do ativo fica nos campos native*, e o câmbio usado em exchangeRate.
  currency               String                   @default("BRL") @db.VarChar(3)
  /// Valor atual na moeda do ativo (US$ 2.000), só quando ela é diferente da moeda do app.
  nativeCurrentValue     Decimal?                 @db.Decimal(18, 2)
  /// Quanto foi investido na moeda do ativo (US$ 1.800).
  nativeInvestedValue    Decimal?                 @db.Decimal(18, 2)
  /// Câmbio da última conversão: 1 unidade da moeda do ativo = X na moeda do app (US$ 1 = R$ 5,02).
  exchangeRate           Decimal?                 @db.Decimal(14, 6)
  idealAllocationPercent Decimal?                 @db.Decimal(6, 3)
  /// A classificação que ELA escolheu ("Trocar" no detalhe do ativo). Nulo = automático (pela
  /// classe e pelo indexador). Valores: pos, ipca, pre, acoes, fiis, multimercado, outros.
  tipoEscolhido          String?                  @db.VarChar(16)
  /// Onde ELA disse que o ativo está: "brasil" ou "exterior". Nulo = automático (moeda e classe).
  ondeEscolhido          String?                  @db.VarChar(16)
  /// A taxa em que ela COMPROU o título de renda fixa (11/10/2026), em FRAÇÃO como toda taxa do app,
  /// lida junto com o fixedIncomeIndex: PREFIXADO 0.12 = 12% ao ano; IPCA 0.075 = IPCA + 7,5% ao
  /// ano; POS_FIXADO 1.05 = 105% do CDI. Nulo = ela não disse. A calculadora "Vender a renda fixa
  /// antes do prazo" lê este campo.
  taxaCompra             Decimal?                 @db.Decimal(10, 6)
  acquisitionDate        DateTime?
  notes                  String?
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime                 @updatedAt
}

/// Provento (dividendo/JSCP/rendimento) de um TICKER — não de um Asset/usuário: um MXRF11 só
/// precisa ser raspado uma vez, mesmo com 50 pessoas tendo ele na carteira (mesmo espírito do
/// cache de cotação em Asset.currentUnitPrice). "Próximos dividendos" na Carteira faz o join
/// com Asset.ticker/quantity na hora de exibir, não guarda nada por usuário aqui.
model DividendEvent {
  id            String   @id @default(cuid())
  /// Normalizado maiúsculo ("MXRF11"), pra casar com Asset.ticker.
  ticker        String
  /// Texto original do investidor10 ("Dividendos", "JSCP", "Rend. Trib."...) — sem enum fechado
  /// porque o site já variou esse rótulo antes e um valor novo não pode quebrar o scraper.
  kind          String
  /// "Data com": quem tem o ativo até este dia tem direito ao provento.
  exDate        DateTime @db.Date
  paymentDate   DateTime @db.Date
  valuePerShare Decimal  @db.Decimal(18, 8)
  fetchedAt     DateTime @default(now())

  // Mesma linha raspada de novo (refresh diário) não duplica.
  @@unique([ticker, kind, exDate, paymentDate, valuePerShare])
  @@index([ticker])
  @@index([paymentDate])
}

/// Preço de fechamento do dia de um TICKER da B3 (não de um usuário), gravado pelo cron de
/// cotações que já roda (api/cron/quotes): uma linha por ticker por dia. É o começo do histórico de
/// preço que a Análise completa vai usar (linha de 12 meses, P/L no tempo). Enquanto não houver
/// meses suficientes, a tela não mostra a linha: nunca um exemplo no lugar.
model PrecoDiario {
  id        String   @id @default(cuid())
  /// Normalizado maiúsculo ("MXRF11"), pra casar com Asset.ticker e DividendEvent.ticker.
  ticker    String
  /// O dia (horário de Brasília) em que o preço foi lido.
  data      DateTime @db.Date
  preco     Decimal  @db.Decimal(18, 6)
  moeda     String   @default("BRL") @db.VarChar(3)
  /// De onde veio ("investidor10").
  fonte     String   @db.VarChar(40)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([ticker, data])
  @@index([data])
}

/// Percentuais-alvo por classe de estratégia definidos pelo próprio usuário (soma = 100%),
/// independente da alocação-ideal por ativo individual em Asset.idealAllocationPercent.
model PortfolioStrategy {
  id            String             @id @default(cuid())
  userId        String
  user          User               @relation(fields: [userId], references: [id])
  /// Perfil financeiro dono deste registro. Nulo só no histórico anterior aos perfis.
  profileId     String?
  profile       FinancialProfile?  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  assetClass    StrategyAssetClass
  targetPercent Decimal            @db.Decimal(6, 3)
  updatedAt     DateTime           @updatedAt

  @@unique([userId, profileId, assetClass])
}

/// Snapshot diário do patrimônio total (soma de Asset.currentValue), gravado de forma
/// oportunista na primeira leitura do dia (ver lib/portfolio/snapshot.ts). É a única peça de
/// histórico real que o app guarda sobre patrimônio — sem ela não há como responder "quanto
/// cresceu" ou "é um novo recorde", já que Asset só guarda o valor atual.
model PatrimonySnapshot {
  id         String            @id @default(cuid())
  userId     String
  user       User              @relation(fields: [userId], references: [id])
  /// Perfil financeiro dono deste registro. Nulo só no histórico anterior aos perfis.
  profileId  String?
  profile    FinancialProfile? @relation(fields: [profileId], references: [id], onDelete: Cascade)
  date       DateTime          @db.Date
  totalValue Decimal           @db.Decimal(18, 2)
  createdAt  DateTime          @default(now())

  @@unique([userId, profileId, date])
  @@index([userId, date])
}

/// Histórico opcional de simulações (financiar vs alugar, consórcio, marcação a mercado, carro).
model Simulation {
  id         String            @id @default(cuid())
  userId     String
  user       User              @relation(fields: [userId], references: [id])
  /// Perfil financeiro dono deste registro. Nulo só no histórico anterior aos perfis.
  profileId  String?
  profile    FinancialProfile? @relation(fields: [profileId], references: [id], onDelete: Cascade)
  type       SimulationType
  name       String?
  inputJson  Json
  outputJson Json
  createdAt  DateTime          @default(now())
}

/// Catálogo compartilhado de critérios das fichas de análise (Ações / FIIs).
/// Editável pela educadora (ADMIN) sem necessidade de deploy.
model AnalysisCriterionDefinition {
  id        String             @id @default(cuid())
  sheetType SheetType
  key       String
  label     String
  helpText  String? // tooltip "onde encontrar os dados"
  category  String // agrupamento qualitativo/quantitativo (ou TIJOLO/PAPEL/COMUM para FIIs)
  weight    Decimal?           @db.Decimal(6, 3)
  order     Int
  active    Boolean            @default(true)
  responses AnalysisResponse[]

  @@unique([sheetType, key])
}

/// Ficha de análise de Ações ou FIIs preenchida por um usuário.
model AnalysisSheet {
  id           String             @id @default(cuid())
  userId       String
  user         User               @relation(fields: [userId], references: [id])
  /// Perfil financeiro dono deste registro. Nulo só no histórico anterior aos perfis.
  profileId    String?
  profile      FinancialProfile?  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  sheetType    SheetType
  ticker       String
  companyName  String?
  fiiType      FiiType?
  analysisDate DateTime           @default(now())
  totalScore   Decimal?           @db.Decimal(8, 2)
  conclusion   String?
  /// Laudo automático (leitura dos indicadores com selo por régua), guardado como snapshot
  /// pra ficha abrir na hora e pra "Reanalisar" dizer o que mudou desde a última leitura.
  laudo        Json?
  laudoReadAt  DateTime?
  /// Nota automática que nasce dos selos (favorável 10 / na média 6 / atenção 2).
  autoScore    Decimal?           @db.Decimal(4, 2)
  responses    AnalysisResponse[]
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
}

model AnalysisResponse {
  id          String                      @id @default(cuid())
  sheetId     String
  sheet       AnalysisSheet               @relation(fields: [sheetId], references: [id], onDelete: Cascade)
  criterionId String
  criterion   AnalysisCriterionDefinition @relation(fields: [criterionId], references: [id])
  value       String?
  score       Decimal?                    @db.Decimal(6, 2)
  note        String?

  @@unique([sheetId, criterionId])
}

/// Lista de e-mails autorizados a criar conta / entrar no app. O acesso é fechado:
/// só quem está aqui e com active=true consegue se cadastrar e logar (admins são exceção).
/// Existe independente de User porque a checagem acontece no cadastro, antes da conta existir.
/// O e-mail é sempre guardado normalizado (minúsculo, sem espaços) para casar com o login.
model AllowedEmail {
  id                  String       @id @default(cuid())
  email               String       @unique
  source              AccessSource @default(MANUAL)
  active              Boolean      @default(true)
  /// Anotação livre: turma, nome do produto no Hubla, motivo da liberação manual etc.
  note                String?
  /// Celular que veio da compra no Hubla — copiado pro User quando a conta é criada.
  phone               String?
  /// Data-limite do acesso (a assinatura é anual). Nulo = acesso sem prazo. Vencido não
  /// desativa sozinho (não apaga `active`) — só bloqueia login/cadastro e aparece como
  /// "Expirado" no painel, pra Dani decidir se renova ou desativa de vez.
  expiresAt           DateTime?
  /// Última fatura do Hubla já processada. O Hubla manda o mesmo evento mais de uma vez
  /// (member_added + payment_succeeded, além de reenvios); sem essa trava, cada reenvio
  /// esticaria o acesso em mais um ano de graça.
  lastHublaInvoiceId  String?
  /// Quando a Hubla avisou que a pessoa saiu (customer.member_removed sem reembolso). O acesso
  /// continua até `expiresAt` e o cron desliga depois. Nulo = não cancelou (ou renovou depois).
  canceladoEm         DateTime?
  /// Id da assinatura na Hubla (vem nos eventos de pagamento), para o link direto do painel.
  hublaSubscriptionId String?
  /// Lembretes de "crie sua conta" (boas-vindas, 30/09/2026): quando saiu o do 1º e o do 4º dia.
  /// Servem de trava: gravados ANTES do envio, uma rodada repetida não manda duas vezes.
  lembreteConta1Em    DateTime?
  lembreteConta2Em    DateTime?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
}

/// Produtos do Hubla que dão acesso ao app. O webhook só libera uma compra se o produto
/// comprado estiver aqui e ativo — assim só os cursos certos liberam, e não qualquer produto.
/// `source` = MANUAL (a Dani adicionou pelo nome) ou HUBLA (o webhook viu numa compra e
/// cadastrou como inativo pra ela decidir). Casamento por hublaProductId (quando conhecido)
/// ou pelo nome normalizado (minúsculo, sem espaços nas pontas).
model AllowedProduct {
  id             String       @id @default(cuid())
  /// Id do produto no Hubla (event.product.id). Nulo quando a Dani cadastrou só pelo nome,
  /// antes de qualquer compra; o webhook preenche assim que vê a primeira venda daquele nome.
  hublaProductId String?      @unique
  name           String
  source         AccessSource @default(MANUAL)
  active         Boolean      @default(true)
  /// O que a compra deste produto libera (05/10/2026): "app" (o acesso de sempre) ou
  /// "money_reset" (só o programa de 21 dias, vendido no order bump). Produto do Money Reset
  /// sozinho NÃO libera o app: sem isso, quem comprasse só ele ganharia o app inteiro.
  concede        String       @default("app")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

/// Inscrição de notificação do navegador (Web Push): um aparelho instalado = uma linha.
/// Sem app na loja, é o que faz "chegar uma mensagem" no celular.
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Aviso já enviado (push ou e-mail), pra nunca repetir o mesmo aviso do mesmo mês.
model NotificationLog {
  id     String   @id @default(cuid())
  userId String
  key    String
  sentAt DateTime @default(now())
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
}

/// Conexão Open Finance (via Pluggy / Meu Pluggy). Um item do Pluggy = um banco conectado.
model BankConnection {
  id            String    @id @default(cuid())
  userId        String
  itemId        String    @unique
  connectorId   Int?
  connectorName String
  status        String    @default("UPDATED")
  lastSyncAt    DateTime?
  lastSyncCount Int       @default(0)
  lastError     String?
  createdAt     DateTime  @default(now())
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Assinatura do SPI Finance comprada pela Apple dentro do app iOS (out/2026, guideline 3.1.1).
/// Liga a compra (originalTransactionId, que se repete em toda renovação) à conta que comprou:
/// os avisos da Apple (renovou, reembolsou) só trazem a transação, não o e-mail. O acesso em si
/// fica no AllowedEmail com source APPLE, igual às compras do Hubla.
model AssinaturaApple {
  originalTransactionId String    @id
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId             String
  expiresAt             DateTime
  /// "Production" ou "Sandbox" (o revisor da Apple compra no Sandbox).
  ambiente              String
  revogadaEm            DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
}

/// Cada pagamento pela Apple (06/10/2026): a primeira compra e cada renovação, com o valor que a
/// pessoa pagou. Serve para o Farol somar as vendas da Apple com as da Hubla. **Sem conta e sem
/// e-mail de propósito**: o Farol lê esta tabela com um acesso que só enxerga ela.
model TransacaoApple {
  transactionId         String    @id
  originalTransactionId String
  productId             String
  /// O que a pessoa pagou, em centavos da moeda (a Apple manda em milésimos). Bruto: a comissão
  /// e o imposto da Apple saem depois, no relatório financeiro dela.
  precoCentavos         Int?
  moeda                 String?
  /// true nas compras anteriores a esta tabela, preenchidas com o preço de tabela do plano.
  precoDeTabela         Boolean   @default(false)
  compradaEm            DateTime
  /// "compra" | "renovacao"
  tipo                  String
  /// "Production" ou "Sandbox"
  ambiente              String
  reembolsadaEm         DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([compradaEm])
}

/// O que a pessoa comprou além do app (05/10/2026): hoje só o Money Reset. Fica no e-mail da
/// compra, como o AllowedEmail, porque a compra chega pela Hubla antes de a conta existir.
model ProdutoLiberado {
  id        String   @id @default(cuid())
  email     String
  /// "money_reset"
  produto   String
  /// "hubla" | "manual" | "apple"
  origem    String   @default("hubla")
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([email, produto])
}

/// Conta a pagar com lembrete (05/10/2026): a Dani pediu "colocar contas a pagar, e o app lembrar
/// você", inclusive as de valor que muda. Aparece no Foco e avisa na véspera e no dia.
model ContaAPagar {
  id                String            @id @default(cuid())
  userId            String
  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  profileId         String?
  profile           FinancialProfile? @relation(fields: [profileId], references: [id], onDelete: Cascade)
  nome              String            @db.VarChar(80)
  /// Nulo = o valor muda todo mês (luz, cartão). O lembrete vale do mesmo jeito.
  valor             Decimal?          @db.Decimal(18, 2)
  /// O próximo vencimento (só a data). Conta que repete anda um mês quando ela marca "paguei".
  vencimento        DateTime          @db.Date
  /// O dia de sempre (1–31). A do dia 31 passa por fevereiro no 28 e volta pro 31 em março.
  diaDoMes          Int?
  repete            Boolean           @default(false)
  /// Avisar na véspera e no dia (Foco, notificação ou e-mail).
  lembrar           Boolean           @default(true)
  /// Quando foi paga pela última vez.
  pagaEm            DateTime?
  /// Conta que não repete e já foi paga: sai da lista.
  quitada           Boolean           @default(false)
  /// Frequência livre (versão nova, 11/10/2026, seção 3.17). Nulo nas contas de antes: elas
  /// continuam como eram, `repete` = todo mês e sem `repete` = não repete.
  /// "A cada N": N de 1 a 36, na `unidade` ("dias" | "semanas" | "meses" | "anos").
  intervalo         Int?
  unidade           String?           @db.VarChar(10)
  /// "Em meses que eu escolho": os meses (1 a 12). Vazio = não é desse jeito.
  mesesEscolhidos   Int[]             @default([])
  /// Parcelada (2 a 48 vezes): quantas parcelas no total e em qual ela está. `valor` é sempre a
  /// parcela; `valorEhTotal` só lembra que ela digitou o total (a tela mostra do mesmo jeito).
  parcelas          Int?
  parcelaAtual      Int?
  valorEhTotal      Boolean           @default(false)
  /// Valor aproximado ("~R$ 130, varia"): `valor` é a estimativa, o extrato manda no de verdade.
  aproximado        Boolean           @default(false)
  /// Contas do histórico (12/10/2026): nulo = ela cadastrou; "historico" = o app achou no extrato
  /// e cadastrou sozinho (selo "do extrato").
  origem            String?           @db.VarChar(12)
  /// Quem cobra, na chave estável do motor ("m:vivo", "enel distribuicao"): é o que casa a conta
  /// achada com o extrato seguinte e com a recusa dela.
  chaveDoHistorico  String?           @db.VarChar(160)
  /// A categoria do lançamento de onde a conta veio.
  categoria         ParentCategory?
  /// Ela mexeu na conta achada: o app não sobrescreve mais valor nem dia.
  editadaPelaPessoa Boolean           @default(false)
  /// Quando o aviso "Achei N contas no seu histórico" foi fechado. Nulo = ainda não viu.
  avisadaEm         DateTime?
  /// Assinatura posta à mão (13/10/2026): "assinatura" mora em Assinaturas, não em Contas a pagar,
  /// e conta como fixo na semana. Nulo = conta. Escolhida dos lançamentos, a `chaveDoHistorico`
  /// guarda o comerciante: os próximos lançamentos dele são reconhecidos como dela.
  tipo              String?           @db.VarChar(12)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@index([userId, profileId, vencimento])
}

/// Conta achada no histórico que a pessoa apagou (ou desfez no aviso): o app nunca recria.
model ContaRecusada {
  id        String            @id @default(cuid())
  userId    String
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  profileId String?
  profile   FinancialProfile? @relation(fields: [profileId], references: [id], onDelete: Cascade)
  /// A mesma `chaveDoHistorico` da conta apagada.
  chave     String            @db.VarChar(160)
  /// O nome e o valor da apagada: seguram também a parecida achada por outro caminho (ela apagou
  /// o "Aluguel" do boleto; o Pix do aluguel não pode aparecer no lugar).
  nome      String?           @db.VarChar(80)
  valor     Decimal?          @db.Decimal(18, 2)
  createdAt DateTime          @default(now())

  @@unique([userId, profileId, chave])
}

/// O estado do fechamento de um mês (versão nova, seção 3.12): um por perfil e mês. Antes era
/// uma marca em Decisao ("fechamento" / "fechamento_reaberto"); a migração copiou as marcas.
/// Sem linha = não fechado. "fechando" são os passos na tela e não é gravado.
model FechamentoDoMes {
  id         String           @id @default(cuid())
  userId     String
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  profileId  String
  profile    FinancialProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  ano        Int
  mes        Int
  /// "fechado" | "reaberto"
  estado     String           @db.VarChar(12)
  fechadoEm  DateTime?
  reabertoEm DateTime?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  @@unique([profileId, ano, mes])
  @@index([userId])
}

/// A foto do perfil (Configurações, versão nova). Fica no banco, só sai para a dona pela rota
/// /api/conta/foto (nunca um link público). User.avatarUrl aponta para essa rota.
model FotoDaConta {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tipo      String   @db.VarChar(40)
  dados     Bytes
  createdAt DateTime @default(now())
}

/// Uma dívida da área Dívidas (versão nova, 11/10/2026), digitada pela pessoa no cadastro de 8 passos.
/// O motor é o do app Rota (lib/dividas): a mais cara primeiro, e a parcela da que acaba passa
/// para a próxima. Saudável, Atenção ou Cara é calculado na hora (depende da Selic do dia), nunca
/// guardado.
model Divida {
  id              String            @id @default(cuid())
  userId          String
  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  profileId       String?
  profile         FinancialProfile? @relation(fields: [profileId], references: [id], onDelete: Cascade)
  /// Um dos 11 tipos do motor (rotativo, cheque_especial, ..., outra).
  tipo            String            @db.VarChar(32)
  credor          String            @db.VarChar(40)
  /// O nome que ela reconhece ("Apê", "Fatura"). Na tela: "Caixa · Apê".
  apelido         String            @default("") @db.VarChar(40)
  /// Para que foi (Casa, Carro, Emergência...).
  paraQue         String?           @db.VarChar(40)
  planejada       Boolean           @default(false)
  /// Quanto falta pagar hoje.
  saldo           Decimal           @db.Decimal(18, 2)
  /// Quanto sai por mês (a parcela, ou o que ela paga quando não tem parcela fixa).
  porMes          Decimal           @db.Decimal(18, 2)
  parcelasAbertas Int?
  parcelasTotal   Int?
  semParcela      Boolean           @default(false)
  /// Taxa ao mês em %. Nulo = "Não sei": vale a estimativa do tipo, marcada "estimada".
  taxaMensal      Decimal?          @db.Decimal(8, 4)
  diaVencimento   Int?
  atrasada        Boolean           @default(false)
  /// "Quitei": sai da lista; o Desfazer volta.
  quitadaEm       DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([userId, profileId])
}

/// A chave do widget da tela inicial do iPhone (11/10/2026). O app gera uma quando a pessoa está
/// logada e guarda no App Group, que a extensão do widget lê. Ela só serve para ler os números do
/// widget (GET /api/widget): não abre sessão, não muda nada e não vale em nenhuma outra rota.
/// Guardamos só o hash (SHA-256); a chave em si aparece uma vez, na resposta que a gera.
model TokenDoWidget {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// SHA-256 da chave, em hex.
  hash       String    @unique
  /// Um id do aparelho, sorteado pelo app (não é o identificador da Apple): gerar de novo no mesmo
  /// aparelho revoga a chave anterior dele.
  aparelho   String    @db.VarChar(64)
  criadoEm   DateTime  @default(now())
  usadoEm    DateTime?
  /// Revogada (saiu da conta, gerou outra, ou desligou o widget). Nunca volta a valer.
  revogadoEm DateTime?

  @@index([userId, aparelho])
}

/// Login do par (11/10/2026, casal-login-proposta.html): o convite que a titular do perfil Casal
/// manda por link. Só o hash do código fica aqui (como a senha): quem lê o banco não monta o link.
/// Um convite aberto por perfil (índice parcial na migration); "Mandar de novo" fecha o anterior
/// como "substituido" e cria outro.
model ConviteCasal {
  id          String           @id @default(cuid())
  profileId   String
  profile     FinancialProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  /// Quem convidou (a titular, dona do perfil).
  userId      String
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  nomePar     String           @db.VarChar(30)
  /// A letra do par no casal ("A" ou "B", a mesma de MonthlyEntry.pessoa).
  letra       String           @db.VarChar(1)
  /// SHA-256 do código do link, em hex.
  tokenHash   String           @unique
  /// Por onde ela mandou: whatsapp, email ou copiar. Nulo = ainda não mandou.
  canal       String?          @db.VarChar(12)
  /// aberto, aceito, cancelado (a titular cancelou) ou substituido ("Mandar de novo").
  /// Vencido não é gravado: é aberto com expiraEm no passado.
  status      String           @default("aberto") @db.VarChar(12)
  expiraEm    DateTime
  enviadoEm   DateTime?
  aceitoEm    DateTime?
  /// A conta que aceitou. Sem chave estrangeira: se ela for excluída, o registro do convite fica.
  aceitoPorId String?
  encerradoEm DateTime?
  createdAt   DateTime         @default(now())

  @@index([profileId, status])
}

/// O par dentro de um perfil Casal: a entrada dele vale pelo vínculo, não por compra. A titular
/// é a dona do perfil (FinancialProfile.userId) e não precisa de linha aqui.
/// Índices parciais na migration: um par ativo por perfil e um casal ativo por pessoa.
model MembroCasal {
  id              String           @id @default(cuid())
  profileId       String
  profile         FinancialProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  userId          String
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// "A" ou "B": liga o par aos lançamentos (MonthlyEntry.pessoa).
  letra           String           @db.VarChar(1)
  entrouEm        DateTime         @default(now())
  /// Saiu (ele saiu, a titular removeu, ou o Casal ficou 90 dias sem renovar). Nulo = ativo.
  saiuEm          DateTime?
  motivoSaida     String?          @db.VarChar(20)
  /// Quando o app viu pela primeira vez o Casal da titular sem valer (não renovou). O acesso do
  /// par para na hora; a saída de vez é 90 dias depois disso. Volta a nulo se ela renovar.
  bloqueadoEm     DateTime?
  /// O par que também tem perfis próprios (comprou o SPI) escolhe onde está: true = no Nós dois.
  emUso           Boolean          @default(true)
  termosVersao    String           @db.VarChar(20)
  termosAceitosEm DateTime
  conviteId       String?
  /// Casal simples (13/10/2026, casal-simples-proposta.html): o modelo que vale para ESTA casa.
  /// "nos-dois" = o de antes (o par entra no perfil Casal da titular). "simples" = cada um no
  /// próprio Pessoal, vendo também o que o outro deixou visível. Só a migração troca
  /// (scripts/migrar-casal-simples.ts), e ela sabe voltar.
  modelo          String           @default("nos-dois") @db.VarChar(10)
  /// No modelo simples: o Pessoal da titular e o do par que formam a casa. Nulos no Nós dois.
  /// Sem chave estrangeira de propósito, como o autorUserId: apagar um perfil não pode apagar o vínculo.
  perfilTitularId String?
  perfilParId     String?
  /// Quando a casa passou para o simples, e o que a migração moveu (o caminho de volta).
  migradoEm       DateTime?
  migracao        Json?

  @@index([userId])
  @@index([profileId])
}

/// Fechar o mês a dois: o mês do perfil Casal fecha quando os dois dizem "Confere". Cada confere
/// guarda a assinatura dos lançamentos do acerto naquele instante; se alguém lança ou muda algo
/// do mês depois, a assinatura muda e o confere cai sozinho.
model FechamentoCasal {
  id          String           @id @default(cuid())
  profileId   String
  profile     FinancialProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  ano         Int
  mes         Int
  confereA    DateTime?
  confereB    DateTime?
  assinaturaA String?          @db.VarChar(64)
  assinaturaB String?          @db.VarChar(64)
  fechadoEm   DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@unique([profileId, ano, mes])
}

/// Limite de tentativas na página pública do convite (/par/...), por aparelho de origem. Guarda
/// só um resumo do IP (SHA-256 com o segredo do app), nunca o IP.
model TentativaDoConvite {
  id    String   @id @default(cuid())
  chave String   @db.VarChar(64)
  em    DateTime @default(now())

  @@index([chave, em])
}

/// Número que vem de fora (Banco Central, Tesouro Transparente), guardado com a fonte e a hora.
/// A tela mostra sempre o último valor que deu certo; se a busca do dia falhar, ele continua
/// valendo e a tela diz "de ontem". Uma linha por série: "bcb:12" (CDI ao dia), "bcb:433" (IPCA
/// do mês), "bcb:432" (meta Selic), "tesouro:Tesouro IPCA+:2035-05-15" (preço e taxa do título).
model IndicadorExterno {
  chave      String   @id @db.VarChar(80)
  /// O número principal (CDI ao ano, IPCA em 12 meses, Selic ao ano, preço unitário do título).
  valor      Decimal  @db.Decimal(18, 8)
  /// Segundo número quando a série tem (a taxa do título do Tesouro, em % ao ano).
  taxa       Decimal? @db.Decimal(12, 6)
  /// A data a que o número se refere (o dia do CDI, o mês do IPCA, a data base do Tesouro).
  referenteA DateTime @db.Date
  /// Quando o app buscou e gravou.
  buscadoEm  DateTime
  fonte      String   @db.VarChar(80)
}

/// "Antes de cancelar" (direção B, 11/10/2026): cada passo de quem abriu o cancelar, para medir
/// qual motivo aparece e o que a pessoa escolheu. Uma linha por escolha, nada é apagado.
model MotivoDeCancelamento {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// caro | dificil | errado | naouso | outro | reembolso (o "Me avisa" dos 7 dias) | sem_motivo (foi direto ao "Quero cancelar mesmo")
  motivo    String   @db.VarChar(12)
  /// aceitou_oferta | foi_cancelar | abriu_hubla | abriu_apple
  escolha   String   @db.VarChar(16)
  /// site (Hubla) ou apple (iPhone)
  via       String   @db.VarChar(8)
  /// O "Outro motivo" escrito pela pessoa (opcional).
  texto     String?  @db.VarChar(2000)
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([userId])
}

/// O que a pessoa aceitou antes de cancelar e que a equipe faz à mão: 2 meses grátis (Hubla e
/// Admin › Acessos), dúvida, número errado, aviso antes da renovação, conversa. Aparece em
/// /admin/pedidos com o "Feito". Cada tipo, uma vez a cada 12 meses por pessoa.
model PedidoAntesDeCancelar {
  id             String    @id @default(cuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// meses_gratis | duvida | contestacao | aviso_renovacao | conversa
  tipo           String    @db.VarChar(16)
  /// O que ela escreveu (a dúvida, ditada ou digitada: o áudio nunca é guardado).
  texto          String?   @db.VarChar(4000)
  /// Onde está o número errado (Saldo, Orçamento, Cartão, Metas, Outro).
  area           String?   @db.VarChar(20)
  /// Aviso antes da renovação: o dia em que o e-mail sai (renovação menos 7 dias).
  avisarEm       DateTime? @db.Date
  /// Para a equipe diagnosticar (algo errado): a tela, o mês e o lançamento marcado.
  dados          Json?
  /// O assunto que a resposta automática achou na dúvida (importar, acesso, categoria, metas, cartao).
  assunto        String?   @db.VarChar(12)
  /// Quando o e-mail desse pedido saiu: a trava para sair uma vez só.
  emailEnviadoEm DateTime?
  /// 2 meses grátis: quando saiu o lembrete para a Dani (24 horas sem "Feito na Hubla"), uma vez só.
  lembreteEm     DateTime?
  /// aberto | feito
  estado         String    @default("aberto") @db.VarChar(8)
  feitoEm        DateTime?
  feitoPor       String?
  createdAt      DateTime  @default(now())

  @@index([estado, createdAt])
  @@index([userId, tipo])
}

/// Números legais que mudam com a lei (11/10/2026): teto do MEI, faixa de tolerância, valor e dia
/// da guia (DAS). Cada linha guarda a fonte e a data da fonte, porque mudam todo janeiro. A tela só
/// mostra o que estiver aqui; sem a linha, o número não aparece. Não é dado de perfil.
model ParametroLegal {
  id           String   @id @default(cuid())
  /// "mei_teto_anual", "mei_teto_tolerancia", "mei_das_servico", "mei_das_dia_vencimento" e, desde
  /// 15/10/2026, as partes da guia: "mei_salario_minimo", "mei_inss_percentual", "mei_das_icms", "mei_das_iss".
  chave        String   @db.VarChar(48)
  valor        Decimal  @db.Decimal(18, 2)
  /// Ano em que passa a valer (o teto de 2026 vale de 1º de janeiro de 2026 em diante).
  vigenteDesde DateTime @db.Date
  fonte        String   @db.VarChar(160)
  fonteData    DateTime @db.Date
  createdAt    DateTime @default(now())

  @@unique([chave, vigenteDesde])
}

/// Dinheiro perdido (12/10/2026, versão B): cada achado que o app mostrou (assinatura, cobrança
/// repetida, tarifa e seguro, aumento) e o que a pessoa decidiu, para não perguntar de novo. O
/// achado em si é recalculado dos lançamentos; aqui fica a decisão e uma fotografia dos valores na
/// hora dela, que é o que soma no "Até agora" (o valor não muda se o extrato mudar depois).
model AchadoDinheiroPerdido {
  id         String            @id @default(cuid())
  userId     String
  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  profileId  String?
  profile    FinancialProfile? @relation(fields: [profileId], references: [id], onDelete: Cascade)
  /// A chave estável do achado ("assinatura:m:netflix", "repetida:m:ifood:5840:2026-09-13").
  chave      String            @db.VarChar(160)
  /// assinatura | repetida | tarifa | aumento
  tipo       String            @db.VarChar(12)
  nome       String            @db.VarChar(80)
  /// Por mês (assinatura, tarifa, aumento = a diferença) e de uma vez (cobrança repetida, tarifa avulsa).
  mensal     Decimal?          @db.Decimal(18, 2)
  unico      Decimal?          @db.Decimal(18, 2)
  /// Detalhes para mostrar de novo (datas, antes x agora, quem cobrou).
  dados      Json?
  /// aberto | uso | nao_uso | pedi_estorno | estornado | descartado
  estado     String            @default("aberto") @db.VarChar(16)
  decididoEm DateTime?
  /// Quando o estorno caiu (sozinho, pelo crédito no extrato, ou porque ela disse "Já voltou").
  estornoEm  DateTime?
  /// Achado que entrou com um extrato novo: nulo até ela abrir as cartas (o "2 cartas novas").
  vistoEm    DateTime?
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  @@unique([userId, profileId, chave])
  @@index([userId, profileId, estado])
}
