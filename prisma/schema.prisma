// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  CLIENT
}

/// De onde veio a liberação de acesso de um e-mail: MANUAL (a Dani liberou no painel)
/// ou HUBLA (liberado automaticamente pelo webhook quando a pessoa comprou/assinou)
/// ou APPLE (assinatura comprada dentro do app iOS, ver AssinaturaApple).
enum AccessSource {
  MANUAL
  HUBLA
  APPLE
}

enum EntryCategory {
  INCOME
  EXPENSE
  INVESTMENT_CONTRIBUTION
}

/// Categoria-mãe do lançamento (segunda camada de categorização, além de EntryCategory).
/// Só se aplica a lançamentos EXPENSE — usada para orçamento mensal por categoria.
enum ParentCategory {
  MORADIA
  ALIMENTACAO
  TRANSPORTE
  SAUDE
  LAZER
  EDUCACAO
  OUTROS
  IMPOSTOS
}

enum GoalStatus {
  NOT_STARTED
  ON_TRACK
  BEHIND
  ACHIEVED
}

/// Ícone temático escolhido pelo usuário para o card da meta.
/// O tipo da meta (versão nova, 11/10/2026: os 18 tipos da nova meta guiada). Os cinco primeiros
/// são os de antes e continuam valendo: APOSENTADORIA é "Liberdade financeira" e GENERICO é "Outro".
enum GoalIcon {
  VIAGEM
  CASA
  CARRO
  APOSENTADORIA
  GENERICO
  RESERVA
  MOTO
  CASAMENTO
  FILHO
  ESTUDOS
  INTERCAMBIO
  REFORMA
  FESTA
  NEGOCIO
  PET
  TECNOLOGIA
  SAUDE
  SHOW
}

enum AssetClass {
  RENDA_FIXA
  ACAO
  FII
  TESOURO_DIRETO
  FUNDO
  CRIPTO
  /// Ativo negociado fora do Brasil (ações/ETFs em dólar, ex.: VOO, AAPL) ou fundo/gestora
  /// que investe no exterior — mapeia pro bucket "Exterior" da Estratégia da Carteira.
  INTERNACIONAL
  OUTRO
}

/// Indexador de um título de renda fixa (só faz sentido para RENDA_FIXA/TESOURO_DIRETO).
/// Define em qual classe da Estratégia o título entra: pós-fixado (CDI/Selic), IPCA+ ou prefixado.
enum FixedIncomeIndex {
  POS_FIXADO
  IPCA
  PREFIXADO
}

/// Objetivo ao qual o ativo está alocado — espelha as categorias da planilha original
/// (Reserva, Liberdade, Meta) para a consolidação "posição atual por objetivo".
enum AssetObjective {
  RESERVA_EMERGENCIA
  LIBERDADE_FINANCEIRA
  META
  OUTRO
}

enum SimulationType {
  FINANCIAR_VS_ALUGAR
  AMORTIZAR_VS_INVESTIR
  CONSORCIO_VS_FINANCIAMENTO
  MARCACAO_MERCADO
  CARRO
}

enum SheetType {
  STOCK
  FII
  STOCK_INTL
  ETF
}

enum FiiType {
  TIJOLO
  PAPEL
  HIBRIDO
  FUNDO_DE_FUNDOS
}

enum RateBasis {
  ANNUAL_252
  ANNUAL_365
  MONTHLY
}

/// Classes usadas na tela "Estratégia da Carteira" — mais granulares que AssetClass
/// (que continua sendo usada no cadastro de ativos individuais). A posição atual por
/// classe de estratégia é derivada de Asset.assetClass por uma função de mapeamento
/// padrão (ver lib/portfolio/strategy.ts), já que são taxonomias diferentes.
enum StrategyAssetClass {
  RENDA_FIXA_POS_FIXADA
  RENDA_FIXA_IPCA
  PREFIXADO
  ACOES_BRASIL
  FIIS
  EXTERIOR
  OUTROS
}

model User {
  id                      String    @id @default(cuid())
  email                   String    @unique
  /// Quando ela clicou no link de confirmação do e-mail. Contas novas só entram no app depois
  /// disso (senão qualquer um cria a conta com o e-mail de uma compradora). Nulo nas contas
  /// criadas antes da regra, que continuam valendo (ver emailConfirmado em src/lib/auth).
  emailVerifiedAt         DateTime?
  passwordHash            String
  /// Celular (WhatsApp) — pedido no cadastro e/ou puxado da compra no Hubla.
  phone                   String?
  name                    String?
  avatarUrl               String?
  role                    Role      @default(CLIENT)
  currency                String    @default("BRL")
  theme                   String    @default("light")
  notifyBudgetAlerts      Boolean   @default(true)
  notifyLateGoals         Boolean   @default(true)
  /// Resumo do mês por e-mail (o único e-mail recorrente do app). Ligado por padrão; quem não
  /// quiser desliga em Configurações › Preferências.
  notifyMonthlyRecap      Boolean   @default(true)
  /// Último mês cujo resumo JÁ foi enviado por e-mail, formato "YYYY-MM". Trava de idempotência:
  /// o cron pode rodar de novo (retry da Vercel, execução manual) sem reenviar o mesmo resumo.
  /// Vale para os DOIS e-mails do dia 1º (resumo de quem usou, convite de quem não usou) — o
  /// mês é tratado uma vez só, não importa qual dos dois saiu.
  recapEmailSentMonth     String?
  /// Quantos convites "vamos começar?" já foram enviados. Quem não usa o app não pode receber
  /// esse lembrete todo mês pra sempre — depois de algumas tentativas sem resposta, o app para
  /// de insistir. Zera sozinho quando a pessoa passa a usar (aí ela recebe o resumo, não o convite).
  recapNudgeCount         Int       @default(0)
  /// Proteção contra força bruta: erros de senha consecutivos e trava temporária.
  failedLoginCount        Int       @default(0)
  lockedUntil             DateTime?
  /// Última vez que o usuário abriu o app (atualizado no layout, no máx. 1x a cada ~15min).
  /// Base das métricas de engajamento (ativos em 24h/7d/30d) no relatório de admin.
  lastSeenAt              DateTime?
  /// Quando a pessoa passou pela tela de boas-vindas (escolheu tipo e tema do primeiro perfil).
  /// Nulo = ainda não passou: o app manda pra /comecar na primeira entrada. Quem já usava o app
  /// antes de set/2026 nasceu preenchido pela migração, pra não ver a tela.
  onboardedAt             DateTime?
  /// "Tivemos uma mudança" (versão nova, 11/10/2026): nulo = quem já usava o app e ainda não viu,
  /// então vê uma vez. "terminou" ou "pulou" = já passou por ele. "novo" = chegou depois da versão
  /// nova (gravado ao sair do /comecar) e nunca vê. Dá para rever pela Ajuda.
  novidadesVersaoNova     String?
  novidadesVistasEm       DateTime?
  /// Mês do Resumo Mensal já visto/fechado, formato "YYYY-MM". Enquanto for o mesmo mês do
  /// resumo atual, o card na Visão Mensal não aparece de novo (fecha uma vez por mês).
  recapDismissedMonth     String?
  /// Assessoria (Carteira, rodada 76): "confirmando" depois que ela toca em "Já abri minha conta";
  /// nulo = ainda não disse que abriu. "Ainda não abri" volta a nulo. Quem confirma de verdade
  /// (cliente) é a equipe da Fatos Capital, num passo futuro: o app só guarda o que ela disse.
  assessoriaEstado        String?   @db.VarChar(16)
  assessoriaEstadoEm      DateTime?
  /// Ela tocou no x do convite do fim da Carteira: a linha some só para ela.
  assessoriaConviteOculto Boolean   @default(false)
  /// Como a pessoa quer acompanhar o dinheiro: "semanal" (ritual de 5 min toda semana) ou
  /// "mensal" (fechamento de 15 min por mês). Nulo = ainda não escolheu; a aba Foco pergunta.
  ritmoAcompanhamento     String?
  /// "Não quero ver ofertas da assessoria" (Configurações › Assessoria): some todo cartão de
  /// oferta da Fatos Capital. Os ajustes de quem já é cliente não são oferta e continuam.
  ofertasDesligadas       Boolean   @default(false)
  /// Meus dados (versão nova, 12/10/2026): a data de nascimento e o dia em que a renda cai.
  nascimento              DateTime? @db.Date
  diaDoPagamento          Int?
  /// O começo da versão nova (11/10/2026): respostas e progresso de quem entrou pelo onboarding
  /// novo (apelido, renda aproximada, o que quer agora, porta, banco, Primeiros passos). Nulo =
  /// nunca passou por ele; quem já usava o app continua nulo e não vê o começo. Ver
  /// src/lib/onboarding/comeco.ts (lerComeco) para o formato.
  comeco                  Json?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  monthlyEntries          MonthlyEntry[]
  importFiles             ImportFile[]
  budgets                 Budget[]
  monthlyPlans            MonthlyPlan[]
  customCategories        CustomCategory[]
  portfolioStrategy       PortfolioStrategy[]
  patrimonySnapshots      PatrimonySnapshot[]
  assets                  Asset[]
  fotosDeMeta             FotoDaMeta[]
  goals                   Goal[]
  emergencyFunds          EmergencyFund[]
  planningParams          PlanningParams[]
  simulations             Simulation[]
  analysisSheets          AnalysisSheet[]
  assinaturasApple        AssinaturaApple[]
  /// appAccountToken das compras pela Apple (ver tokenDaConta). Guardado pra o aviso da Apple
  /// achar a conta sozinho: compra aprovada depois ("Pedir para comprar") ou reembolso que chega
  /// antes de o app registrar a compra.
  tokenApple              String?                       @unique
  referenceRates          ReferenceRate[]
  yearlyConsolidations    YearlyConsolidationCache[]
  accumulationCache       AccumulationProjectionCache[]
  transactionRules        TransactionCategoryRule[]
  regrasDePerfil          RegraDePerfil[]
  regrasDaCasa            RegraDaCasa[]
  passwordResetTokens     PasswordResetToken[]
  importBatches           ImportBatch[]
  importDiagnostics       ImportDiagnostic[]
  contributionAllocations ContributionAllocation[]
  usageEvents             UsageEvent[]

  asAdvisorLinks         AdvisorClientLink[]     @relation("advisor")
  asClientLinks          AdvisorClientLink[]     @relation("client")
  pushSubscriptions      PushSubscription[]
  notificationLogs       NotificationLog[]
  bankConnections        BankConnection[]
  financialProfiles      FinancialProfile[]
  decisoes               Decisao[]
  contasAPagar           ContaAPagar[]
  tokensDoWidget         TokenDoWidget[]
  dividas                Divida[]
  achadosDinheiroPerdido AchadoDinheiroPerdido[]
  contasRecusadas        ContaRecusada[]
  /// Login do par (11/10/2026): convites que esta conta mandou e os perfis Casal em que ela é o par.
  convitesCasal          ConviteCasal[]
  membrosCasal           MembroCasal[]
  fechamentos            FechamentoDoMes[]
  fotoDaConta            FotoDaConta?
  motivosDeCancelamento  MotivoDeCancelamento[]
  pedidosAntesDeCancelar PedidoAntesDeCancelar[]
}

/// Ambiente financeiro independente dentro da MESMA conta: Pessoal, Empresa, Casal, Casa…
///
/// Existe porque a mesma pessoa organiza dinheiros que não se misturam — o gasto da empresa não
/// pode entrar na taxa de poupança dela, e a meta do casal não é a meta pessoal. Tudo que é
/// dinheiro pendura no perfil; o que é da CONTA (sessão, push, e-mail, uso do app) continua no
/// usuário, porque trocar de perfil não troca de pessoa.
///
/// `profileId` nasce opcional de propósito: as tabelas já existiam cheias de dado real quando
/// isto entrou. A coluna entra vazia, o backfill preenche, e só então as leituras passam a
/// filtrar. Em nenhum instante o dado de alguém deixa de ser encontrado.
model FinancialProfile {
  id               String      @id @default(cuid())
  userId           String
  user             User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  name             String
  /// Adapta textos e sugestões; a estrutura é a mesma pra todos.
  kind             ProfileKind @default(PESSOAL)
  /// Nome do ícone na biblioteca do app (lucide), não emoji: o produto não depende de emoji.
  icon             String      @default("wallet")
  /// Chave do TEMA do perfil (ver src/lib/profiles/themes.ts), nunca cor crua vinda da tela.
  /// O tema traz a paleta inteira — fundo, cartão, tinta e destaque —, não só o realce.
  theme            String      @default("padrao")
  /// Perfil de investidora da estratégia da Carteira: conservador, moderado, arrojado ou
  /// personalizado (quando ela mexe nos números). Nulo = estratégia montada antes de 11/10/2026.
  perfilInvestidor String?     @db.VarChar(16)
  /// Chave da paleta antiga, de quando o perfil escolhia só a cor de destaque. Substituída
  /// pelo tema em set/2026 e não lida mais por tela nenhuma. Fica na tabela porque derrubar
  /// coluna em banco de produção é risco sem ganho — sai numa limpeza própria, depois.
  color            String      @default("ambar")
  /// O que a pessoa mudou nas categorias padrão deste perfil: nome, ícone, escondida
  /// ({ "IMPOSTOS": { "oculta": true }, "LAZER": { "nome": "Rolês", "icone": "coffee" } }).
  /// Lido por lerPreferenciasDeCategoria (src/lib/categories.ts). Nulo = tudo de fábrica.
  categorias       Json?
  /// Perfil Casal: { nomeA, nomeB, divisao: "renda" | "meio", acertos: ["2026-10", ...] }.
  casal            Json?
  /// Perfil Empresa (11/10/2026), o que o assistente perguntou: { tipo: "MEI" | "AUTONOMA" | "ME",
  /// faz, formas, prazoCredito, salario, diaDoSalario, lembreteDas, taxas, abertoEm }. Lido por
  /// lerConfigEmpresa (src/lib/empresa/config.ts). Nulo = o assistente ainda não rodou.
  empresa          Json?
  /// Quanto este perfil combinou gastar no cartão de crédito por mês (06/10/2026). Nulo = sem
  /// limite. Vale para todo mês até ela mudar; o aviso sai em 70%, 90% e 100%.
  limiteCartao     Decimal?    @db.Decimal(18, 2)
  /// Ordem na troca rápida de perfil.
  position         Int         @default(0)
  /// O perfil que abre quando a pessoa entra. Exatamente um por conta.
  isDefault        Boolean     @default(false)
  /// Perfil criado pelo backfill pra abrigar o histórico de quem já usava o app.
  isLegacy         Boolean     @default(false)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  monthlyEntries          MonthlyEntry[]
  budgets                 Budget[]
  monthlyPlans            MonthlyPlan[]
  customCategories        CustomCategory[]
  fotosDeMeta             FotoDaMeta[]
  goals                   Goal[]
  assets                  Asset[]
  emergencyFund           EmergencyFund?
  planningParams          PlanningParams?
  portfolioStrategy       PortfolioStrategy[]
  patrimonySnapshots      PatrimonySnapshot[]
  importBatches           ImportBatch[]
  contributionAllocations ContributionAllocation[]
  transactionRules        TransactionCategoryRule[]
  regrasDePerfil          RegraDePerfil[]               @relation("RegraDePerfilOrigem")
  regrasQueTrazemPraCa    RegraDePerfil[]               @relation("RegraDePerfilDestino")
  regrasDaCasa            RegraDaCasa[]
  simulations             Simulation[]
  analysisSheets          AnalysisSheet[]
  yearlyConsolidations    YearlyConsolidationCache[]
  accumulationCache       AccumulationProjectionCache[]
  decisoes                Decisao[]
  contasAPagar            ContaAPagar[]
  dividas                 Divida[]
  achadosDinheiroPerdido  AchadoDinheiroPerdido[]
  contasRecusadas         ContaRecusada[]
  convitesCasal           ConviteCasal[]
  membrosCasal            MembroCasal[]
  fechamentosCasal        FechamentoCasal[]
  fechamentos             FechamentoDoMes[]

  @@index([userId, position])
}

/// Uma decisão que a pessoa tomou dentro do app: desistiu de uma compra, deixou pra decidir
/// amanhã, fechou o ritual da semana, fechou o mês, pôs um teto numa categoria, cancelou uma
/// assinatura no Raio-X, avisou que uma resposta estava errada.
///
/// Existe porque o app dizia o que fazer, mas não lembrava do que a pessoa fez. Sem esse
/// registro não dá pra mostrar "o que você conquistou" nem saber se o ritual da semana já foi
/// feito. Um tipo por string (não enum) de propósito: tipo novo não pode exigir migração.
model Decisao {
  id          String            @id @default(cuid())
  userId      String
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  profileId   String?
  profile     FinancialProfile? @relation(fields: [profileId], references: [id], onDelete: Cascade)
  /// compra_desisti | compra_amanha | compra_comprei | ritual | fechamento | teto |
  /// raiox_cancelar | raiox_metade | raiox_manter | resposta_errada
  tipo        String
  /// Identifica a decisão pra não repetir: a semana ("2026-W40"), o mês ("2026-08"), o gasto
  /// recorrente do Raio-X. Nulo quando cada decisão é única (uma compra).
  chave       String?
  /// Valor em reais quando existe (a compra que não foi feita, o teto da categoria).
  valor       Decimal?          @db.Decimal(18, 2)
  descricao   String?
  /// Detalhes que só servem pra exibir (parcelas, categoria, a regra que rodou).
  dados       Json?
  /// "Decidir amanhã": quando a pessoa respondeu. Nulo = ainda esperando.
  resolvidaEm DateTime?
  createdAt   DateTime          @default(now())

  @@index([userId, profileId, tipo])
  @@index([userId, createdAt])
}

/// Tipo do perfil. Muda texto e sugestão, nunca a estrutura — a pessoa continua livre pra
/// montar o perfil como quiser.
enum ProfileKind {
  PESSOAL
  EMPRESA
  CASAL
  CASA
  PROJETO
  OUTRO
}

/// Token de recuperação de senha. Guardamos só o HASH do token (nunca o valor cru) — o link
/// enviado por e-mail carrega o token, e aqui comparamos pelo hash. Vale 1 hora e uma vez só.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

/// Regra aprendida de classificação de extrato (item 3 da Rodada 2): quando o usuário resolve
/// uma transação na fila de revisão, guardamos merchant → categoria para classificar sozinho
/// as próximas transações parecidas. `pattern` é a chave normalizada (ver normalizeMerchant).
model TransactionCategoryRule {
  id               String            @id @default(cuid())
  userId           String
  user             User              @relation(fields: [userId], references: [id])
  /// Perfil financeiro dono deste registro. Nulo só no histórico anterior aos perfis.
  profileId        String?
  profile          FinancialProfile? @relation(fields: [profileId], references: [id], onDelete: Cascade)
  pattern          String
  parentCategory   ParentCategory
  subcategory      String?
  /// A categoria que ELA criou ("Dani Invest"), quando foi essa a escolha. Manda sobre a
  /// parentCategory (que fica como reserva, OUTROS). Apagar a categoria apaga a regra.
  customCategoryId String?
  customCategory   CustomCategory?   @relation(fields: [customCategoryId], references: [id], onDelete: Cascade)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@unique([userId, profileId, pattern])
  @@index([userId])
}

/// Casal simples (13/10/2026): o que o app aprendeu sobre "da casa" com os toques dela. Tocar
/// "Da casa" ou "Meu" num gasto grava a regra do comerciante (a mesma chave da regra de
/// categoria, chaveDoComerciante), e os próximos gastos dali já chegam classificados. Vale só
/// para o que ainda não tem escolha própria no lançamento (MonthlyEntry.doCasal nulo).
model RegraDaCasa {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  profileId String
  profile   FinancialProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  pattern   String           @db.VarChar(80)
  daCasa    Boolean
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@unique([userId, profileId, pattern])
}

/// "Sempre mandar para a Empresa" (12/10/2026): a compra deste comerciante que aparece numa
/// importação DESTE perfil (o cartão Pessoal) já vem marcada para o perfil de destino na revisão.
/// Nasce quando ela move lançamentos já importados de um perfil para outro e pede para lembrar.
/// `pattern` é a chave do comerciante (ver chaveDoComerciante), como na regra de categoria.
model RegraDePerfil {
  id               String           @id @default(cuid())
  userId           String
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// O perfil de onde a compra sai (o da importação).
  profileId        String
  profile          FinancialProfile @relation("RegraDePerfilOrigem", fields: [profileId], references: [id], onDelete: Cascade)
  /// Para onde ela vai. Apagar o perfil de destino apaga a regra.
  destinoProfileId String
  destino          FinancialProfile @relation("RegraDePerfilDestino", fields: [destinoProfileId], references: [id], onDelete: Cascade)
  pattern          String
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@unique([userId, profileId, pattern])
  @@index([userId])
}

model AdvisorClientLink {
  id        String   @id @default(cuid())
  advisorId String
  clientId  String
  status    String // INVITED | ACTIVE | REVOKED
  advisor   User     @relation("advisor", fields: [advisorId], references: [id])
  client    User     @relation("client", fields: [clientId], references: [id])
  createdAt DateTime @default(now())

  @@unique([advisorId, clientId])
}

/// Tabela de premissas/taxas de referência editáveis (CDI, IPCA, Selic...).
/// userId nulo = taxa padrão global (seed do sistema).
model ReferenceRate {
  id            String    @id @default(cuid())
  userId        String?
  user          User?     @relation(fields: [userId], references: [id])
  name          String
  rateValue     Decimal   @db.Decimal(12, 6)
  basis         RateBasis
  effectiveDate DateTime
  createdAt     DateTime  @default(now())

  @@index([userId])
}

/// Categoria-mãe personalizada, criada pelo próprio usuário quando as 7 categorias fixas
/// (ParentCategory) não bastam. Vive fora do enum de propósito — o usuário pode apagar uma
/// categoria personalizada a qualquer momento, o que não faria sentido pra um valor de enum
/// (exigiria migração toda vez). Um MonthlyEntry/Budget de despesa pertence a exatamente uma
/// categoria: ou uma ParentCategory fixa, ou uma CustomCategory — nunca as duas (invariante
/// de aplicação, no mesmo espírito pragmático da subcategoria "Outro", que também não é enum).
model CustomCategory {
  id             String                    @id @default(cuid())
  userId         String
  user           User                      @relation(fields: [userId], references: [id])
  /// Perfil financeiro dono deste registro. Nulo só no histórico anterior aos perfis.
  profileId      String?
  profile        FinancialProfile?         @relation(fields: [profileId], references: [id], onDelete: Cascade)
  name           String
  icon           String
  createdAt      DateTime                  @default(now())
  monthlyEntries MonthlyEntry[]
  budgets        Budget[]
  regras         TransactionCategoryRule[]

  @@unique([userId, profileId, name])
}

/// Lançamento mensal — substitui as 12 abas Jan..Dez da planilha original.
/// Rastreio de uso PRÓPRIO (sem script de terceiro): cada navegação dentro do app vira um
/// evento — qual tela, quem, quando e se estava no app instalado (tela de início) ou no
/// navegador. Alimenta a seção "páginas mais visitadas" do /admin/relatorio. Admins não são
/// gravados (poluiriam a estatística).
model UsageEvent {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Tipo do evento; hoje só "pageview", o campo existe pra eventos futuros (ex.: "voz_usada").
  name       String
  /// Rota normalizada ("/mensal/[ano]/[mes]"), nunca a URL crua com ids.
  path       String
  /// true = app aberto pela tela de início (instalado), false = pelo navegador.
  standalone Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([userId, createdAt])
  @@index([path, createdAt])
}

/// Lote de importação: um upload de extrato/fatura. Dá o histórico do que foi subido em massa
/// e permite desfazer o lote inteiro (arquivo errado ou duplicado) de uma vez.
/// Erro de servidor que estourou em produção, guardado por 30 dias.
///
/// O log da Vercel cobre ~45 minutos e não há log drain: qualquer erro mais antigo que isso
/// some. Sem isso, "verificar todo dia os erros do app" não teria o que verificar. Guarda a
/// rota, a mensagem e a pilha cortada — nunca corpo de requisição, cookie ou dado de cliente.
model AppError {
  id         String   @id @default(cuid())
  /// Rota do arquivo ("/mensal/[year]/[month]"), não a URL com dados na query.
  routePath  String?
  /// render | route | action | proxy
  routeType  String?
  method     String?
  message    String
  digest     String?
  stack      String?
  /// Quantas vezes esta mesma assinatura (rota + mensagem) estourou.
  vezes      Int      @default(1)
  primeiroEm DateTime @default(now())
  ultimoEm   DateTime @default(now())

  @@unique([routePath, message])
  @@index([ultimoEm])
}

/// Diagnóstico de CADA tentativa de importação, inclusive as que falharam.
///
/// Sem isso, arquivo que o app não consegue ler não deixa rastro nenhum: nenhum lote é criado
/// e o log da Vercel some em poucos dias. Foi assim que sete pessoas pediram reembolso sem a
/// gente saber qual banco quebrou. Aqui fica o suficiente pra reproduzir: nome do arquivo,
/// o que o app entendeu, quantas linhas viu, quantas leu e o erro — nunca o conteúdo.
model ImportDiagnostic {
  id          String      @id @default(cuid())
  userId      String
  user        User        @relation(fields: [userId], references: [id])
  /// "extrato" | "fatura" | "carteira"
  target      String
  /// "parse" (leitura) | "confirm" (gravação)
  stage       String
  ok          Boolean
  fileName    String?
  /// text | xlsx | pdf
  encoding    String?
  /// O que o perfil do documento concluiu: statement, invoice, position, irpf, unknown
  kind        String?
  institution String?
  /// Linhas com cara de dinheiro no arquivo × lançamentos/ativos que o app conseguiu ler.
  moneyLines  Int         @default(0)
  parsed      Int         @default(0)
  created     Int         @default(0)
  skipped     Int         @default(0)
  /// Mensagem que a pessoa viu na tela, quando deu errado.
  message     String?
  /// Primeira linha do arquivo (cabeçalho), cortada — é o que identifica o formato do banco.
  header      String?
  /// O arquivo em si, guardado só quando a leitura falhou ou veio parcial.
  file        ImportFile?
  /// Quando o app puxou conversa com a pessoa sobre ESTE erro (ManyChat). Null = ninguém falou
  /// com ela ainda. É o que impede de avisar a mesma pessoa duas vezes pelo mesmo problema.
  avisadoEm   DateTime?
  /// Como terminou o aviso: "enviado", ou o motivo de não ter ido (fora-da-janela,
  /// nao-encontrado...). Guardado pra Dani saber quem precisa ser chamada na mão.
  avisoStatus String?
  createdAt   DateTime    @default(now())

  @@index([createdAt])
  @@index([ok, createdAt])
}

/// Arquivo de importação guardado quando a leitura FALHOU ou veio pela metade.
///
/// Existe porque o motivo nº 1 de reembolso é "subi meu extrato e não veio nada", e até aqui o
/// arquivo sumia junto com a pessoa: sobrava o cabeçalho no diagnóstico, que não basta pra
/// descobrir a disposição das colunas de um banco que o app ainda não conhece. Sem o arquivo, a
/// única saída era pedir por WhatsApp — e quem desiste calado nunca responde.
///
/// É dado pessoal sensível (extrato bancário), então: só o que deu errado, nunca importação bem
/// sucedida; prazo de validade curto, apagado sozinho pela checagem diária; e leitura só pelo
/// ADMIN.
model ImportFile {
  id           String            @id @default(cuid())
  userId       String
  user         User              @relation(fields: [userId], references: [id])
  /// O diagnóstico que registrou esta falha, quando existe.
  diagnosticId String?           @unique
  diagnostic   ImportDiagnostic? @relation(fields: [diagnosticId], references: [id], onDelete: Cascade)
  fileName     String?
  /// text | xlsx | pdf
  encoding     String?
  mimeType     String?
  /// Tamanho em bytes do que está guardado.
  bytes        Int
  content      Bytes
  /// "falha" (não leu nada) | "parcial" (leu menos da metade das linhas com valor)
  reason       String
  /// Depois desta data a checagem diária apaga o arquivo.
  expiresAt    DateTime
  createdAt    DateTime          @default(now())

  @@index([createdAt])
  @@index([expiresAt])
}

model ImportBatch {
  id           String            @id @default(cuid())
  userId       String
  user         User              @relation(fields: [userId], references: [id])
  /// Perfil financeiro dono deste registro. Nulo só no histórico anterior aos perfis.
  profileId    String?
  profile      FinancialProfile? @relation(fields: [profileId], references: [id], onDelete: Cascade)
  /// "extrato" | "fatura"
  docType      String
  fileName     String?
  /// Casal simples (13/10/2026): a conta deste extrato ou fatura está escondida do par ("Mostrar
  /// para <par>" desligado em Contas e cartões). Copiado para todos os lotes da mesma conta (ver
  /// chaveDaConta em src/lib/casa/regras.ts), e o lote novo herda o da conta.
  ocultoDoPar  Boolean           @default(false)
  /// Print da fatura ABERTA (13/10/2026): as compras vieram de capturas de tela da lista do app
  /// do banco, antes de a fatura fechar. Parcial por definição. Quando a fatura fechada chega, as
  /// compras iguais passam para o lote dela (com o valor, o dia e o nome da fatura) em vez de
  /// entrar de novo; ver src/lib/import/fatura-aberta.ts.
  faturaAberta Boolean           @default(false)
  createdAt    DateTime          @default(now())
  entries      MonthlyEntry[]

  @@index([userId, createdAt])
}

model MonthlyEntry {
  id                 String                   @id @default(cuid())
  userId             String
  user               User                     @relation(fields: [userId], references: [id])
  /// Perfil financeiro dono deste registro. Nulo só no histórico anterior aos perfis.
  profileId          String?
  profile            FinancialProfile?        @relation(fields: [profileId], references: [id], onDelete: Cascade)
  year               Int
  month              Int
  category           EntryCategory
  parentCategory     ParentCategory?
  customCategoryId   String?
  customCategory     CustomCategory?          @relation(fields: [customCategoryId], references: [id])
  subcategory        String?
  description        String?
  amount             Decimal                  @db.Decimal(18, 2)
  /// Lançamento feito em outra moeda (salário em euro pra quem mora fora): o valor digitado, a
  /// moeda dele e a cotação usada. `amount` continua sempre na moeda do usuário — todo o resto do
  /// app soma `amount` e não precisa saber que houve conversão.
  /// Id da transação no banco (Open Finance): "pluggy:<id>". É o que garante que uma
  /// transação nunca entra duas vezes, por definição, sem depender de descrição ou data.
  externalId         String?
  originalAmount     Decimal?                 @db.Decimal(18, 2)
  originalCurrency   String?                  @db.VarChar(3)
  exchangeRate       Decimal?                 @db.Decimal(14, 6)
  /// Data em que a despesa/renda de fato aconteceu (opcional — lançamentos antigos não têm).
  /// year/month continuam sendo a verdade para a consolidação mensal; entryDate refina o dia.
  entryDate          DateTime?                @db.Date
  goalId             String?
  goal               Goal?                    @relation(fields: [goalId], references: [id])
  /// Pedaços deste aporte que já foram para ativos da carteira.
  allocations        ContributionAllocation[]
  /// Lote de importação que criou este lançamento (nulo = lançado à mão). SetNull: apagar o
  /// registro do lote nunca apaga lançamentos por efeito colateral — a exclusão em massa é
  /// sempre explícita na action, dentro de uma transação.
  importBatchId      String?
  importBatch        ImportBatch?             @relation(fields: [importBatchId], references: [id], onDelete: SetNull)
  /// Série de uma despesa fixa ("Repetir todo mês"): todas as cópias levam o mesmo id. É o que
  /// deixa editar ou apagar "este e os próximos" de uma vez. Nulo = lançamento avulso.
  recurrenceId       String?
  /// Perfil Casal: quem pagou (gasto) ou recebeu (entrada) — "A" ou "B", os nomes ficam em
  /// FinancialProfile.casal. Nulo = não informado (e nos outros perfis, sempre nulo).
  pessoa             String?                  @db.VarChar(1)
  /// Perfil Casal: gasto da casa (entra no acerto do mês) ou pessoal (false, fica de fora).
  /// Nulo = da casa, o padrão.
  doCasal            Boolean?
  /// Gasto feito no cartão de crédito (06/10/2026, limite do cartão). true = cartão, false = não
  /// (Pix, débito, dinheiro), null = não informado. Linha de fatura importada antes disso fica null
  /// e conta como cartão pelo lote (ImportBatch.docType "fatura"); ver lib/cartao/limite.ts.
  noCartao           Boolean?
  /// Login do par (11/10/2026): a conta que lançou. Nulo = a dona do perfil (tudo que existia
  /// antes do par). Sem chave estrangeira de propósito: o par pode excluir a conta dele e o
  /// histórico do casal continua com quem paga, como a proposta aprovada diz.
  autorUserId        String?
  /// "Só meu" no perfil Casal: só quem lançou vê, nem o total aparece para o outro. Fica fora do
  /// acerto (é gravado com doCasal = false). O do par é gravado com o userId DELE, o da titular
  /// com o dela, então as consultas de sempre (userId + profileId) já não cruzam os dois.
  soMeu              Boolean                  @default(false)
  /// Casal simples (15/10/2026, versão A do mockup): o gasto é do PAR de quem lançou ("Do Lucas").
  /// Com isso ligado, doCasal fica false. Entra no acerto quando quem lançou pagou.
  doPar              Boolean                  @default(false)
  /// Casal simples: quem pagou foi o par de quem lançou (e não quem lançou, o padrão).
  pagouOPar          Boolean                  @default(false)
  /// Casal simples, gasto da casa: a divisão própria deste gasto ("renda", "meio" ou "outra").
  /// Nulo = a regra da casa (Configurações › Casa).
  divisaoPropria     String?                  @db.VarChar(6)
  /// Com divisaoPropria "outra": a parte de quem lançou, em % (0 a 100).
  parteDeQuemLancou  Decimal?                 @db.Decimal(5, 2)
  /// Perfil Empresa (11/10/2026), tudo opcional: de quem foi a venda ("Café Lume"), como pagou
  /// (pix, credito, debito, boleto, dinheiro), o dia em que o dinheiro cai e o dia em que ela
  /// marcou "Recebi". Nos outros perfis, sempre nulos.
  cliente            String?                  @db.VarChar(80)
  formaDeRecebimento String?                  @db.VarChar(10)
  recebeEm           DateTime?                @db.Date
  recebidoEm         DateTime?                @db.Date
  /// "Dividir com alguém" (versão nova, 12/10/2026): com quem ela dividiu ("Marina"). `amount`
  /// passa a ser só a parte dela (o que fica no orçamento) e `parteDeOutro` guarda o que a outra
  /// pessoa deve; o total da compra é a soma dos dois. `devolvidoEm`: o dia do "Recebi" (o Pix
  /// abate o que ela tinha a receber, não conta como renda). Presente ("Não, eu dei"): divididoCom
  /// preenchido e parteDeOutro nulo.
  divididoCom        String?                  @db.VarChar(40)
  parteDeOutro       Decimal?                 @db.Decimal(18, 2)
  devolvidoEm        DateTime?                @db.Date
  createdAt          DateTime                 @default(now())

  @@unique([userId, profileId, externalId])
  @@index([userId, year, month])
  @@index([userId, recurrenceId])
  @@index([userId, parentCategory])
  @@index([userId, customCategoryId])
  @@index([importBatchId])
}

/// Orçamento mensal planejado por categoria-mãe (para a barra "gasto realizado vs. planejado").
model Budget {
  id               String            @id @default(cuid())
  userId           String
  user             User              @relation(fields: [userId], references: [id])
  /// Perfil financeiro dono deste registro. Nulo só no histórico anterior aos perfis.
  profileId        String?
  profile          FinancialProfile? @relation(fields: [profileId], references: [id], onDelete: Cascade)
  year             Int
  month            Int
  parentCategory   ParentCategory?
  customCategoryId String?
  customCategory   CustomCategory?   @relation(fields: [customCategoryId], references: [id])
  plannedAmount    Decimal           @db.Decimal(18, 2)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@unique([userId, profileId, year, month, parentCategory, customCategoryId])
}

/// Planejamento do que ENTRA e do que vai ser guardado, por mês.
///
/// O Budget cobre só o que sai (gasto planejado por categoria). Faltava o outro lado: quanto a
/// pessoa espera ganhar e quanto pretende aportar. Sem isso o app comparava o gasto com o
/// planejado, mas não tinha como dizer "você ganhou menos do que esperava" nem "você aportou
/// metade do que tinha planejado" — que é onde mora metade da conversa sobre organizar dinheiro.
///
/// Uma linha por mês (igual ao Budget), mesmo quando o valor é o mesmo o ano todo: assim dá pra
/// ajustar um mês específico (décimo terceiro, férias) sem mexer nos outros.
model MonthlyPlan {
  id                String            @id @default(cuid())
  userId            String
  user              User              @relation(fields: [userId], references: [id])
  /// Perfil financeiro dono deste registro. Nulo só no histórico anterior aos perfis.
  profileId         String?
  profile           FinancialProfile? @relation(fields: [profileId], references: [id], onDelete: Cascade)
  year              Int
  month             Int
  /// Renda esperada no mês.
  plannedIncome     Decimal           @db.Decimal(18, 2)
  /// Aporte pretendido no mês.
  plannedInvestment Decimal           @db.Decimal(18, 2)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@unique([userId, profileId, year, month])
}

/// Cache opcional de consolidação anual (substitui Database -> Pivôs -> Consolidado do Ano).
/// Só deve ser preenchido/usado se aggregation queries diretas apresentarem latência real.
model YearlyConsolidationCache {
  id              String            @id @default(cuid())
  userId          String
  user            User              @relation(fields: [userId], references: [id])
  /// Perfil financeiro dono deste registro. Nulo só no histórico anterior aos perfis.
  profileId       String?
  profile         FinancialProfile? @relation(fields: [profileId], references: [id], onDelete: Cascade)
  year            Int
  totalIncome     Decimal           @db.Decimal(18, 2)
  totalExpense    Decimal           @db.Decimal(18, 2)
  totalInvestment Decimal           @db.Decimal(18, 2)
  balance         Decimal           @db.Decimal(18, 2)
  updatedAt       DateTime          @updatedAt

  @@unique([userId, profileId, year])
}

/// Metas múltiplas (uma linha por meta na planilha original).
model Goal {
  id                    String            @id @default(cuid())
  userId                String
  user                  User              @relation(fields: [userId], references: [id])
  /// Perfil financeiro dono deste registro. Nulo só no histórico anterior aos perfis.
  profileId             String?
  profile               FinancialProfile? @relation(fields: [profileId], references: [id], onDelete: Cascade)
  name                  String
  targetAmount          Decimal           @db.Decimal(18, 2)
  targetDate            DateTime?
  currentAmount         Decimal           @default(0) @db.Decimal(18, 2)
  monthlyContribution   Decimal?          @db.Decimal(18, 2)
  annualRate            Decimal?          @db.Decimal(12, 6)
  /// A viagem que criou esta meta (destinos, dias, pessoas, estilo, mês e valores trocados), pelo
  /// assistente da Viagem. É o que faz "Editar" abrir o cartão de embarque. Nulo nas outras metas.
  viagem                Json?
  status                GoalStatus        @default(NOT_STARTED)
  icon                  GoalIcon          @default(GENERICO)
  /// Mês (YYYY-MM) já perguntado "fez o aporte sugerido?" pra esta meta — mesmo padrão do
  /// User.recapDismissedMonth. Enquanto for o mesmo mês da janela atual, o check-in não
  /// aparece de novo (já foi respondido, seja "fiz", "fiz parcial" ou "não fiz").
  checkinDismissedMonth String?
  /// A foto da meta: uma do banco do app ("/fotos/metas/europa.jpg") ou a da pessoa
  /// ("/api/metas/foto/<id>", guardada em FotoDaMeta e servida só para a dona). Nula nas metas
  /// antigas: a tela usa a foto do tipo.
  fotoUrl               String?
  /// Mês (YYYY-MM) em que ela respondeu "Ainda não" ao aporte: o cartão para de perguntar até o
  /// fim do mês. Separado do checkinDismissedMonth, que quer dizer "aporte feito".
  aporteAdiadoMes       String?
  /// Lançamentos do extrato que ela disse que NÃO foram para esta meta ("Foi para esta meta?" >
  /// Não). Só ids de MonthlyEntry; a meta não pergunta de novo sobre eles.
  aportesRecusados      String[]          @default([])
  entries               MonthlyEntry[]
  assets                Asset[]
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
}

/// A foto que a pessoa escolheu para uma meta ("Usar uma minha"). Fica no banco, já reduzida no
/// aparelho (lado maior até 1280 px), e só sai pela rota autenticada /api/metas/foto/[id], que
/// confere a dona: nunca um link público e previsível.
model FotoDaMeta {
  id        String            @id @default(cuid())
  userId    String
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  profileId String?
  profile   FinancialProfile? @relation(fields: [profileId], references: [id], onDelete: Cascade)
  tipo      String
  dados     Bytes
  createdAt DateTime          @default(now())

  @@index([userId, profileId])
}

/// Para onde foi o dinheiro de um aporte: liga o lançamento do fluxo aos ativos da carteira.
///
/// Sem isso os três módulos não conversavam. A pessoa lançava "aportei R$ 2.500" no mês, ia na
/// carteira e não via nada; atualizava a carteira e o mês continuava igual; e a meta somava o
/// aporte E o ativo, contando o mesmo dinheiro duas vezes. Um aporte pode ser dividido em
/// vários ativos, então é uma linha por pedaço.
model ContributionAllocation {
  id        String            @id @default(cuid())
  userId    String
  user      User              @relation(fields: [userId], references: [id])
  /// Perfil financeiro dono deste registro. Nulo só no histórico anterior aos perfis.
  profileId String?
  profile   FinancialProfile? @relation(fields: [profileId], references: [id], onDelete: Cascade)
  entryId   String
  entry     MonthlyEntry      @relation(fields: [entryId], references: [id], onDelete: Cascade)
  assetId   String
  asset     Asset             @relation(fields: [assetId], references: [id], onDelete: Cascade)
  amount    Decimal           @db.Decimal(18, 2)
  createdAt DateTime          @default(now())

  @@index([userId, createdAt])
  @@index([entryId])
  @@index([assetId])
}

/// Reserva de emergência./// Reserva de emergência.
