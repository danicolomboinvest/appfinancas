DATABASE_URL="postgresql://user:password@host:5432/dbname?schema=public"
AUTH_SECRET="generate-with: openssl rand -base64 32"

# E-mail transacional (boas-vindas + redefinir senha). Sem essas variáveis o app funciona,
# mas o "esqueci minha senha" vira um beco sem saída silencioso — configure antes de lançar.
SMTP_HOST="smtp.hostinger.com"
SMTP_PORT="465"
SMTP_USER="contato@seudominio.com.br"
SMTP_PASSWORD=""

# Opcional: protege a rota /api/cron/quotes quando o agendador não é o cron da Vercel.
CRON_SECRET=""

# Acesso fechado: token compartilhado com o Hubla. É o MESMO valor que você cadastra no
# painel do Hubla (Webhooks) e aqui — o webhook /api/webhooks/hubla só aceita chamadas que
# tragam esse token no header x-hubla-token. Sem ele, o webhook recusa tudo (fail closed).
# Gere um valor aleatório: openssl rand -hex 32
HUBLA_WEBHOOK_TOKEN=""

# Web Push (avisos no celular): gere um par com node -e "console.log(require('web-push').generateVAPIDKeys())"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:seu@email.com
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Suporte humano: número do WhatsApp com DDI (ex.: 5511999999999). Vazio = o item some do menu.
NEXT_PUBLIC_SUPPORT_WHATSAPP=

# Open Finance via Pluggy (Meu Pluggy). Credenciais do painel dashboard.pluggy.ai. Vazias = o recurso fica desligado.
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=

# Para onde vai o raio-X diário de erros de importação (padrão: SMTP_USER)
SUPPORT_EMAIL=

# --- Suporte: puxar conversa com quem teve erro na importação ---
# Número do WhatsApp que atende (o mesmo do ManyChat), com DDI. Aparece no botão "Me ajuda com
# isso" das telas de erro e no menu. Sem ele o botão some — é assim que está hoje em produção.
NEXT_PUBLIC_SUPPORT_WHATSAPP=
# Token da API do ManyChat (Settings → API no painel deles).
MANYCHAT_API_TOKEN=
# Flow ns do fluxo "deu erro na importação" que a Dani escreveu no ManyChat (ex.: content20260919...).
MANYCHAT_FLOW_ERRO_IMPORTACAO=
